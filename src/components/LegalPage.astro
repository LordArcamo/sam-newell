---
import Base from '../layouts/Base.astro';
import { LEGAL_UPDATED } from '../data/legal';
interface Props { title: string; h1: string; lead: string; description: string; path: string; sections: { h: string; p: string }[] }
const { title, h1, lead, description, path, sections } = Astro.props;
---
<Base title={title} description={description} crumbs={[{ name: h1, path }]}>
  <section class="lg wrap">
    <header class="lg-h">
      <h1 class="lg-t"><span class="ln"><span>{h1}</span></span></h1>
      <p class="lead" data-rv style="--i:1">{lead}</p>
    </header>
    <div class="lg-b">
      {sections.map((s, i) => (
        <div class="lg-s" data-rv style={`--i:${Math.min(i, 3)}`}>
          <h2>{s.h}</h2>
          <p>{s.p}</p>
        </div>
      ))}
      <p class="small lg-u">Last updated {LEGAL_UPDATED}.</p>
    </div>
  </section>
</Base>
<style>
  .lg {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 5vw;
    padding-block: 120px var(--sec);
  }
  .lg-h {
    position: sticky;
    top: calc(var(--bar) + 32px);
    align-self: start;
    display: grid;
    gap: 18px;
  }
  .lg-t {
    font-size: clamp(56px, 6vw, 96px);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .ln {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .ln > span {
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ln > span {
      animation: lg-rise 1s var(--ease-expo) 0.15s both;
    }
    :global(html.arriving) .ln > span {
      animation-delay: 0.85s;
    }
    @keyframes lg-rise {
      from {
        transform: translateY(105%);
      }
    }
  }
  .lg-u {
    opacity: 0.7;
  }
  .lg-b {
    display: grid;
    gap: 40px;
    max-width: 62ch;
  }
  .lg-s h2 {
    font-size: 32px;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }
  @media (max-width: 900px) {
    .lg {
      grid-template-columns: 1fr;
      padding-top: 64px;
    }
    .lg-h {
      position: static;
    }
  }
</style>
