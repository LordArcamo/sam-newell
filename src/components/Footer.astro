---
import Logo from './Logo.astro';
import towns from '../data/towns.json';
import { FOOTER_SAM, SOCIALS, BROKERAGE, CONTACT, SITE } from '../data/site';
const year = 2026;
---
<footer class="foot dark" data-foot>
  <h2 class="sr-only">Site footer</h2>
  <div class="cols wrap">
    <nav aria-labelledby="f-sam">
      <p class="col-h" id="f-sam">Sam</p>
      <ul role="list">{FOOTER_SAM.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <nav aria-labelledby="f-towns">
      <p class="col-h" id="f-towns">Towns</p>
      <ul role="list" class="towns">{towns.map((t) => <li><a href={`/?town=${t.slug}#map`}>{t.name}</a></li>)}</ul>
    </nav>
    <nav aria-labelledby="f-follow">
      <p class="col-h" id="f-follow">Follow</p>
      <ul role="list">{SOCIALS.map((s) => <li><a href={s.href} rel="noopener me" target="_blank">{s.label}</a></li>)}</ul>
    </nav>
    <div class="note">
      <p class="col-h" id="f-note">Sam’s market note</p>
      <p>One short email when the Utah market moves.</p>
      <form class="news" action="/api/newsletter" method="post" data-news novalidate>
        <label class="sr-only" for="news-email">Email address</label>
        <input id="news-email" name="email" type="email" autocomplete="email" placeholder="Email address" required />
        <div class="hp" aria-hidden="true"><label for="news-co">Company</label><input id="news-co" name="company" tabindex="-1" autocomplete="off" /></div>
        <button class="btn light" type="submit">Join</button>
        <p class="news-msg small" role="status" aria-live="polite" tabindex="-1" data-news-msg></p>
      </form>
      <p class="call"><a href={CONTACT.phoneHref}>Call or text {CONTACT.phone}</a></p>
    </div>
  </div>
  <div class="wordmark wrap" aria-hidden="true">
    <Logo variant="caps" class="wm" title="" />
  </div>
  <p class="legal wrap small">
    Sam Newell, {SITE.title.toLowerCase()}, with {BROKERAGE.name}, {BROKERAGE.street}, {BROKERAGE.city}, {BROKERAGE.region} {BROKERAGE.zip}, {BROKERAGE.phone}.
    Equal Housing Opportunity. Reviews quoted word for word from Zillow and Apple Podcasts. Elevation: USGS 3DEP (public domain).
    © {year} Sam Newell. <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a>
  </p>
</footer>

<style>
  .foot {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 112px;
    padding-bottom: 28px;
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr 1.6fr;
    gap: 40px;
  }
  .col-h {
    font-family: var(--display);
    font-weight: 600;
    font-size: 22px;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }
  .cols ul {
    display: grid;
    gap: 2px;
  }
  .cols a {
    display: inline-block;
    padding: 4px 0;
    text-decoration: none;
    font-size: 17px;
  }
  .cols a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .towns {
    grid-template-columns: 1fr 1fr;
    column-gap: 20px;
  }
  .note > p {
    max-width: 34ch;
  }
  .news {
    margin-top: 18px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    max-width: 460px;
  }
  .news input {
    min-height: 52px;
    padding: 0 16px;
    background: var(--paper);
    color: var(--ink);
    border: 0;
    border-radius: 0;
    font-size: 17px;
  }
  .news input::placeholder {
    color: #4a4a4a;
  }
  .news input:focus-visible {
    outline: 3px solid var(--paper);
    outline-offset: 3px;
  }
  .news-msg {
    grid-column: 1 / -1;
    min-height: 1.4em;
  }
  .news-msg:focus {
    outline: none;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .call {
    margin-top: 28px;
    font-weight: 600;
  }
  .call a {
    text-decoration: none;
    font-size: 20px;
  }
  .wordmark {
    margin-top: 96px;
  }
  .wordmark :global(.wm) {
    width: 100%;
    height: auto;
  }
  .legal {
    margin-top: 28px;
    max-width: 120ch;
    font-weight: 400;
  }
  .legal a {
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr 1fr;
      row-gap: 56px;
    }
    .note {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 767px) {
    .foot {
      padding-top: 80px;
    }
    .wordmark {
      margin-top: 72px;
    }
  }
</style>
