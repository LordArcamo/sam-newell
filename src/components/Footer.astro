---
import Logo from './Logo.astro';
import towns from '../data/towns.json';
import { FOOTER_SAM, SOCIALS, BROKERAGE, CONTACT, SITE, LICENCE_LINE } from '../data/site';
const year = 2026;
---
<footer class="foot dark" data-foot>
  <h2 class="sr-only">Site footer</h2>
  <div class="cols wrap">
    <nav aria-labelledby="f-sam">
      <p class="col-h" id="f-sam">Sam</p>
      <ul role="list">{FOOTER_SAM.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <nav aria-labelledby="f-towns">
      <p class="col-h" id="f-towns">Towns</p>
      <ul role="list" class="towns">{towns.map((t) => <li><a href={`/?town=${t.slug}#map`}>{t.name}</a></li>)}</ul>
    </nav>
    <nav aria-labelledby="f-follow">
      <p class="col-h" id="f-follow">Follow</p>
      <ul role="list">{SOCIALS.map((s) => <li><a href={s.href} rel="noopener me" target="_blank">{s.label}</a></li>)}</ul>
    </nav>
    <div class="note">
      <p class="col-h" id="f-note">Sam’s market note</p>
      <p>One short email when the Utah market moves.</p>
      <form class="news" action="/api/newsletter/" method="post" data-news novalidate>
        <label class="sr-only" for="news-email">Email address</label>
        <input id="news-email" name="email" type="email" autocomplete="email" placeholder="Email address" required />
        <div class="hp" aria-hidden="true"><label for="news-co">Company</label><input id="news-co" name="company" tabindex="-1" autocomplete="off" /></div>
        <button class="btn light" type="submit">Join</button>
        <p class="news-msg small" role="status" aria-live="polite" tabindex="-1" data-news-msg></p>
      </form>
    </div>
  </div>
  <p class="phone wrap num"><a href={CONTACT.phoneHref} aria-label={`Call or text Sam at ${CONTACT.phone}`}>{CONTACT.phone}</a></p>
  <div class="lock wrap">
    <Logo variant="caps" class="wm" title="Sam Newell" />
    <p class="small">Call or text. English and Spanish.</p>
  </div>
  <p class="legal wrap small">
    Sam Newell, {SITE.title.toLowerCase()}. {LICENCE_LINE}, {BROKERAGE.phone}.
    Equal Housing Opportunity. Reviews quoted word for word from Zillow and Apple Podcasts. Elevation: USGS 3DEP (public domain). I-15: © OpenStreetMap contributors, ODbL.
    © {year} Sam Newell. <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a>
  </p>
</footer>

<style>
  .foot {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 112px;
    padding-bottom: 28px;
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr 1.6fr;
    gap: 40px;
  }
  .col-h {
    font-family: var(--display);
    font-weight: 600;
    font-size: 24px;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }
  .cols ul {
    display: grid;
    gap: 2px;
  }
  .cols a {
    display: inline-block;
    padding: 4px 0;
    text-decoration: none;
    font-size: 18px;
  }
  .cols a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .towns {
    grid-template-columns: 1fr 1fr;
    column-gap: 20px;
  }
  .note > p {
    max-width: 34ch;
  }
  .news {
    margin-top: 18px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    max-width: 460px;
  }
  .news input {
    min-height: 52px;
    padding: 0 16px;
    background: #ececec;
    color: #0a0a0a;
    border: 0;
    border-radius: 0;
    font-size: 18px;
  }
  .news input::placeholder {
    color: #4a4a4a;
  }
  .news input:focus-visible {
    outline: 3px solid #0a0a0a;
    outline-offset: 3px;
  }
  .news-msg {
    grid-column: 1 / -1;
    min-height: 1.4em;
  }
  .news-msg:focus {
    outline: none;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .call {
    margin-top: 28px;
    font-weight: 600;
  }
  .call a {
    text-decoration: none;
    font-size: 24px;
  }
  /* contact as the headline (research §4.4 #11) */
  .phone {
    margin-top: 96px;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(64px, 10vw, 168px);
    letter-spacing: -0.05em;
    line-height: 0.9;
  }
  .phone a {
    text-decoration: none;
    display: inline-block;
    transition: transform 0.5s var(--ease-expo);
  }
  .phone a:hover {
    transform: translateX(12px);
  }
  .lock {
    margin-top: 36px;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
  }
  .lock :global(.wm) {
    height: 40px;
    width: auto;
  }
  .legal {
    margin-top: 28px;
    max-width: 75ch;
    font-weight: 400;
  }
  .legal a {
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr 1fr;
      row-gap: 56px;
    }
    .note {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 420px) {
    .towns {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 767px) {
    .foot {
      padding-top: 80px;
    }
    .phone {
      margin-top: 64px;
      font-size: 15vw;
    }
    .lock {
      flex-direction: column;
      align-items: flex-start;
    }
    .lock :global(.wm) {
      height: 28px;
    }
  }
</style>
