---
/**
 * Lehi Light inner-page hero (research §4.6): a full-height dark picture panel (square corners), the title in
 * General Sans Light bottom-left (two lines), one sentence, one button and the phone. The picture is the LCP:
 * eager, high priority, never hidden or animated in (it only drifts, under motion-allowed).
 */
import Pic from './Pic.astro';
import { CONTACT } from '../data/site';
import type { ImageMetadata } from 'astro';
interface Props {
  title: string;
  lead: string;
  cta?: { href: string; label: string; external?: boolean };
  image: ImageMetadata;
  alt: string;
  pos?: string;
  tone?: boolean;
  cursor?: string;
}
const { title, lead, cta, image, alt, pos = '50% 50%', cursor = 'View' } = Astro.props;
---
<section class="ih" aria-labelledby="ih-h" data-ih>
  <div class="ih-p" data-cursor={cursor}>
    <Pic src={image} alt={alt} sizes="(max-width: 1536px) 100vw, 1536px" pos={pos} eager />
  </div>
  <div class="ih-shade" aria-hidden="true"></div>
  <div class="ih-t">
    <h1 class="ih-h" id="ih-h"><span class="ln"><span set:html={title} /></span></h1>
    <p class="lead ih-lead">{lead}</p>
    {cta && (
      <p class="ih-act">
        <a class="btn" href={cta.href} rel={cta.external ? 'noopener' : undefined} target={cta.external ? '_blank' : undefined}>
          {cta.label} <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="ih-tel" href={CONTACT.phoneHref}>or call {CONTACT.phone}</a>
      </p>
    )}
    <slot />
  </div>
</section>
<style>
  .ih {
    position: relative;
    height: calc(100svh - var(--bar));
    min-height: 600px;
    max-height: 1100px;
    overflow: hidden;
    background: #0a0a0a;
    color: #fff;
    margin: 0 10px;
  }
  .ih-p {
    position: absolute;
    inset: 0;
    max-width: 1536px;
    margin-inline: auto;
  }
  .ih-p :global(.ph) {
    height: 100%;
    background: #141414;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ih-p :global(img) {
      animation: ih-drift 26s ease-in-out infinite alternate;
      transform-origin: 50% 60%;
    }
    @keyframes ih-drift {
      from {
        transform: scale(1.02);
      }
      to {
        transform: scale(1.09) translate3d(-1%, -0.8%, 0);
      }
    }
    /* arriving through the curtain: the title rises out of its mask as the curtain lifts */
    :global(html.arriving) .ln > span {
      display: inline-block;
      transform: translateY(105%);
      animation: ih-rise 1s var(--ease-expo) 0.85s forwards;
    }
    @keyframes ih-rise {
      to {
        transform: none;
      }
    }
  }
  .ih-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0.1) 62%, rgb(0 0 0 / 0)); /* taste-skill-ignore gradient: neutral scrim under text on a photo */
  }
  .ih-t {
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: 36px;
    display: grid;
    gap: 20px;
    justify-items: start;
    z-index: 2;
  }
  .ih-h {
    font-weight: 300;
    font-size: clamp(56px, 6vw, 96px);
    letter-spacing: -0.045em;
    line-height: 0.98;
    max-width: 12ch;
  }
  .ln {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .ln > span {
    display: inline-block;
  }
  .ih-lead {
    max-width: 34ch;
  }
  .ih-act {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 22px;
  }
  .ih-tel {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  @media (max-width: 767px) {
    .ih {
      height: 88svh;
      min-height: 560px;
      margin: 0 8px;
    }
    .ih-t {
      left: 20px;
      right: 20px;
      bottom: 24px;
    }
    .ih-h {
      font-size: clamp(44px, 13vw, 60px);
    }
  }
</style>
