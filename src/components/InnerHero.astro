---
import Arrow from './Arrow.astro';
/**
 * Lehi Light inner-page hero (research §4.6): a full-height dark picture panel (square corners), the title in
 * General Sans Light bottom-left (two lines), one sentence, one button and the phone. The picture is the LCP:
 * eager, high priority, never hidden: under motion-allowed it settles in by its wrapper, behind a fading veil, and drifts.
 */
import { getImage } from 'astro:assets';
import { CONTACT } from '../data/site';
import type { ImageMetadata } from 'astro';
interface Props {
  title: string;
  lead: string;
  cta?: { href: string; label: string; external?: boolean };
  image: ImageMetadata;
  alt: string;
  pos?: string;
  tone?: boolean;
  cursor?: string;
}
const { title, lead, cta, image, alt, pos = '50% 50%', cursor = 'View' } = Astro.props;
// phones: the picture stands on its own above the words, at its own shape (between 4:5 and 3:2), so no head is cut
const ar = Math.min(1.5, Math.max(0.8, image.width / image.height)).toFixed(3);
// desktop: a portrait photo is never cropped to a wide band (heads and chins stay in); it stands at its own shape on
// the right of the panel and the words sit on the black field to its left
const portrait = image.width / image.height < 1.1;
const nar = (image.width / image.height).toFixed(3);

// The picture is the LCP, so it is built here rather than through Pic: its own `sizes` per layout (a phone must not
// fetch a desktop file), a lighter AVIF for phones (q38: 40-100 KB at 390 px x 3; desktop q50, as Pic produced), and
// the same AVIF sets preloaded in <head> (Base lifts the two data-ih-pre links there).
// Phones and portrait tablets stack the picture over the words; landscape screens from 768 px (short laptops at
// 1000×540 included) take the desktop split, so the title is always on the first screen. DESK is the exact complement:
// the <source media>, the preloads and `sizes` all use these two, so a page downloads one hero file.
const PHONE = '(max-width: 767px), (max-width: 1023px) and (orientation: portrait)';
const DESK = '(min-width: 1024px), (min-width: 768px) and (orientation: landscape)';
const fit = (ws: number[]) => {
  const out = ws.filter((w) => w <= image.width);
  if (!out.length || (out[out.length - 1] < image.width && image.width < ws[ws.length - 1])) out.push(image.width);
  return out;
};
const set = async (ws: number[], format: 'avif' | 'webp', quality: number) =>
  (await Promise.all(ws.map(async (w) => `${(await getImage({ src: image, width: w, format, quality })).src} ${w}w`))).join(', ');
const phoneWs = fit([360, 540, 720, 900, 1080]);
const deskWs = fit([720, 960, 1280, 1600, 2000]);
// phones: the panel is the full width less the 8 px margins. Desktop: the full panel (10 px margins, 1536 max); a
// portrait photo stands at its own shape on the right, at most 62% of the panel and the panel's height (≤ 100svh).
const phoneSizes = 'calc(100vw - 16px)';
const deskSizes = portrait ? `min(62vw, ${(image.width / image.height * 100).toFixed(1)}vh)` : 'min(100vw - 20px, 1536px)';
const sizes = `(max-width: 767px) ${phoneSizes}, (max-width: 1023px) and (orientation: portrait) ${phoneSizes}, ${deskSizes}`;
const phoneAvif = await set(phoneWs, 'avif', 38);
const deskAvif = await set(deskWs, 'avif', 50);
const webp = await set([...new Set([...phoneWs, ...deskWs])].sort((a, b) => a - b), 'webp', 58);
const fallback = await getImage({ src: image, width: Math.min(1280, image.width), format: 'webp', quality: 58 });
---
<link rel="preload" as="image" type="image/avif" media={PHONE} imagesrcset={phoneAvif} imagesizes={phoneSizes} fetchpriority="high" data-ih-pre />
<link rel="preload" as="image" type="image/avif" media={DESK} imagesrcset={deskAvif} imagesizes={deskSizes} fetchpriority="high" data-ih-pre />
<section class:list={['ih', { portrait }]} aria-labelledby="ih-h" data-ih style={`--ar:${ar};--nar:${nar}`}>
  <div class="ih-p" data-cursor={cursor}>
    <div class="ph">
      <picture>
        <source type="image/avif" media={PHONE} srcset={phoneAvif} sizes={phoneSizes} />
        <source type="image/avif" srcset={deskAvif} sizes={deskSizes} />
        <source type="image/webp" srcset={webp} sizes={sizes} />
        <img src={fallback.src} alt={alt} width={image.width} height={image.height} loading="eager" fetchpriority="high" decoding="async" style={`object-position:${pos}`} />
      </picture>
    </div>
  </div>
  <div class="ih-shade" aria-hidden="true"></div>
  <div class="ih-t">
    <h1 class="ih-h" id="ih-h"><span class="ln"><span set:html={title} /></span></h1>
    <p class="lead ih-lead">{lead}</p>
    {cta && (
      <p class="ih-act">
        <a class="btn" href={cta.href} rel={cta.external ? 'noopener' : undefined} target={cta.external ? '_blank' : undefined}>
          {cta.label} <Arrow />
        </a>
        <a class="ih-tel" href={CONTACT.phoneHref}>or call {CONTACT.phone}</a>
      </p>
    )}
    <slot />
  </div>
</section>
<style>
  .ih {
    position: relative;
    height: calc(100svh - var(--bar));
    min-height: min(600px, calc(100svh - var(--bar))); /* a short laptop (1000×540) gets the whole panel on screen */
    max-height: 1100px;
    overflow: hidden;
    background: #0a0a0a;
    color: #fff;
    margin: 0 10px;
  }
  .ih-p {
    position: absolute;
    inset: 0;
    max-width: 1536px;
    margin-inline: auto;
    overflow: hidden;
  }
  .ih-p :global(.ph) {
    height: 100%;
    background: #141414;
  }
  .ih.portrait .ih-p {
    left: auto;
    right: 0;
    height: 100%;
    width: auto;
    aspect-ratio: var(--nar);
    max-width: 62%;
  }
  .ih.portrait .ih-shade {
    display: none;
  }
  .ih.portrait .ih-t {
    right: auto;
    max-width: 36%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ih-p :global(img) {
      animation: ih-drift 26s ease-in-out infinite alternate;
      transform-origin: 50% 60%;
    }
    @keyframes ih-drift {
      from {
        transform: scale(1.02);
      }
      to {
        transform: scale(1.09) translate3d(-1%, -0.8%, 0);
      }
    }
    /* Entrance, on every visit. Direct: the title rises out of its mask after 0.2 s while the picture settles
       (1.045 → 1) and comes up from a veil. Through the curtain (html.via, set in <head>): both wait for html.lift,
       the moment wipe.ts lifts the curtain onto the decoded picture; a fail-safe runs them if no script does.
       LCP-safe: the <img> is painted at full opacity from the first frame. Only its wrapper (.ph) is transformed,
       and the veil is a separate layer over it. Renaming the animation restarts it, hence three names apiece. */
    :global(.js) .ln > span {
      animation: ih-rise 1s var(--ease-expo) 0.2s both;
    }
    :global(html.via) .ln > span {
      animation-name: ih-rise-via;
      animation-delay: 1.6s;
    }
    :global(html.via.lift) .ln > span {
      animation-name: ih-rise-lift;
      animation-delay: 0.3s;
    }
    :global(.js) .ih-p > :global(.ph) {
      animation: ih-settle 1.8s var(--ease-expo) both;
    }
    :global(.js) .ih-p::after {
      animation: ih-veil 1.2s var(--ease-out) both;
    }
    :global(html.via) .ih-p > :global(.ph) {
      animation-name: ih-settle-via;
      animation-delay: 1.3s;
    }
    :global(html.via) .ih-p::after {
      animation-name: ih-veil-via;
      animation-delay: 1.3s;
    }
    :global(html.via.lift) .ih-p > :global(.ph) {
      animation-name: ih-settle-lift;
      animation-delay: 0.05s;
    }
    :global(html.via.lift) .ih-p::after {
      animation-name: ih-veil-lift;
      animation-delay: 0.05s;
    }
    @keyframes ih-rise {
      from {
        transform: translateY(105%);
      }
    }
    @keyframes ih-rise-via {
      from {
        transform: translateY(105%);
      }
    }
    @keyframes ih-rise-lift {
      from {
        transform: translateY(105%);
      }
    }
    @keyframes ih-settle {
      from {
        transform: scale(1.045);
      }
    }
    @keyframes ih-settle-via {
      from {
        transform: scale(1.045);
      }
    }
    @keyframes ih-settle-lift {
      from {
        transform: scale(1.045);
      }
    }
    @keyframes ih-veil {
      from {
        opacity: 0.4;
      }
    }
    @keyframes ih-veil-via {
      from {
        opacity: 0.4;
      }
    }
    @keyframes ih-veil-lift {
      from {
        opacity: 0.4;
      }
    }
  }
  /* the veil the picture comes up from (entrance only: it rests at opacity 0) */
  .ih-p::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #0a0a0a;
    opacity: 0;
    pointer-events: none;
  }
  .ih-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0.1) 62%, rgb(0 0 0 / 0)); /* taste-skill-ignore gradient: neutral scrim under text on a photo */
  }
  .ih-t {
    position: absolute;
    left: 28px;
    bottom: 36px;
    max-width: calc(100% - 56px); /* shrink-wraps the words, so the scrim below is only as big as they are */
    display: grid;
    gap: 20px;
    justify-items: start;
    z-index: 2;
  }
  /* The scrim behind the words (jury r3 P1-2): one flat black layer the size of the text block, feathered by a
     blur, so a bright photo darkens only where the title and lead sit. White Light 300 keeps ≥ 3:1 behind the
     title and ≥ 4.5:1 behind the lead on the brightest frames. */
  .ih-t::before {
    content: '';
    position: absolute;
    inset: -56px -96px -44px -56px;
    z-index: -1;
    background: #000;
    opacity: 0.55;
    filter: blur(44px);
    pointer-events: none;
  }
  .ih.portrait .ih-t::before {
    display: none; /* the words sit on the black field beside a portrait photo */
  }
  .ih-h {
    font-weight: 300;
    font-size: clamp(48px, min(6vw, 11svh), 96px);
    letter-spacing: -0.045em;
    line-height: 0.98;
    max-width: 12ch;
  }
  .ln {
    display: block;
    overflow: hidden;
    /* room above the cap height inside the mask (line-height 0.98 clipped the top of "Get Leveraged" at 820);
       the negative margin keeps the line spacing unchanged */
    padding: 0.1em 0 0.06em;
    margin-top: -0.1em;
  }
  .ln > span {
    display: inline-block;
  }
  .ih-lead {
    max-width: 34ch;
  }
  .ih-act {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 22px;
  }
  .ih-tel {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  /* very short landscape screens (a phone on its side, 844×390): a smaller title and a wider text column, so the
     whole block fits the panel */
  @media (max-height: 500px) and (orientation: landscape) and (min-width: 768px) {
    .ih-h {
      font-size: 40px;
    }
    .ih-t {
      gap: 12px;
      bottom: 20px;
    }
    .ih.portrait .ih-t {
      max-width: 48%;
    }
  }
  @media (max-width: 767px), (max-width: 1023px) and (orientation: portrait) {
    .ih {
      height: auto;
      min-height: 0;
      max-height: none;
      margin: 0 8px;
      overflow: visible;
    }
    .ih-p,
    .ih.portrait .ih-p {
      position: relative;
      aspect-ratio: var(--ar);
      width: auto;
      height: auto;
      max-width: none;
      /* a tall photo on a portrait tablet (820×1180) leaves room for the title on the first screen; the crop is
         cover from the page's object-position, a few percent off top and bottom, faces whole */
      max-height: max(240px, calc(100svh - var(--bar) - 220px));
      overflow: hidden;
    }
    .ih.portrait .ih-t {
      max-width: none;
    }
    .ih-shade {
      display: none;
    }
    .ih-t {
      position: static;
      max-width: none;
      padding: 28px 12px 8px;
    }
    .ih-t::before {
      display: none; /* stacked: the words sit on black below the picture */
    }
    .ih-h {
      font-size: clamp(44px, 13vw, 60px);
    }
  }
</style>
