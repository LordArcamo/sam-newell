---
/**
 * Process steps: a line in the left gutter draws down with the reader and each step's node fills as it passes
 * (motion.ts [data-draw="rule"]). One large picture per step (at least 40vw, opening with the shutter) on
 * alternating sides; a step can carry the stud-wall drawing instead of a photograph.
 */
import Pic from './Pic.astro';
import StudWall from './StudWall.astro';
import type { ImageMetadata } from 'astro';
type Ratio = '' | 'r32' | 'r45' | 'r1610' | 'r11' | 'r43' | 'r169';
interface Step { h: string; p: string; img?: ImageMetadata; alt?: string; pos?: string; id?: string; ratio?: string; drawing?: string; cap?: string }
interface Props { heading: string; steps: Step[]; id?: string }
const { heading, steps, id = 'steps' } = Astro.props;
---
<section class="steps sec wrap" aria-labelledby={`${id}-h`} data-rule-host>
  <h2 class="h" id={`${id}-h`} data-rv>{heading}</h2>
  <div class="st-wrap">
    <svg class="line-art st-rule" viewBox="0 0 2 100" preserveAspectRatio="none" aria-hidden="true" focusable="false" data-draw="rule" data-start="top 75%" data-end="bottom 65%"><line x1="1" y1="0" x2="1" y2="100" /></svg>
    <ol role="list" class="st-list">
      {steps.map((s, i) => (
        <li class:list={['st', { flip: i % 2 === 1, pic: !!(s.img || s.drawing), tall: s.ratio === 'r45' }]} id={s.id}>
          <span class="st-n" data-node aria-hidden="true"></span>
          <div class="st-t">
            <h3 class="st-h" data-rv>{s.h}</h3>
            <p class="st-p" data-rv style="--i:1" set:html={s.p} />
          </div>
          {s.drawing === 'wall' ? (
            <div class="st-art"><StudWall /></div>
          ) : (
            s.img && (
              <figure class="st-img">
                <div data-shutter><Pic src={s.img} alt={s.alt ?? ''} sizes="(max-width: 900px) 100vw, 44vw" ratio={(s.ratio ?? 'r43') as Ratio} pos={s.pos} rv={false} /></div>
                {s.cap && <figcaption class="st-cap">{s.cap}</figcaption>}
              </figure>
            )
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .steps .h {
    margin-bottom: 72px;
    max-width: 14ch;
  }
  .st-wrap {
    position: relative;
    padding-left: 56px;
  }
  .st-rule {
    position: absolute;
    left: 4px;
    top: 10px;
    width: 2px;
    height: calc(100% - 10px);
    color: inherit;
    opacity: 0.6;
  }
  .st-list {
    display: grid;
    gap: 120px;
  }
  .st {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px 5vw;
    align-items: center;
  }
  .st:not(.pic) {
    grid-template-columns: minmax(0, 1fr);
  }
  .st.flip {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  .st.flip .st-t {
    order: 2;
  }
  .st.tall .st-img {
    width: min(100%, 30vw);
    justify-self: center;
  }
  /* the node on the line, level with the middle of the step */
  .st-n {
    position: absolute;
    left: -57px;
    top: 50%;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    transition: background-color 0.5s var(--ease-out);
  }
  .st:not(.pic) .st-n {
    top: 14px;
  }
  .st-n:global(.lit) {
    background: var(--ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .st-n {
      background: var(--ink);
    }
  }
  .st-t {
    max-width: 520px;
  }
  .st.flip .st-t {
    justify-self: start;
  }
  .st-h {
    font-size: var(--t-sub);
    letter-spacing: -0.025em;
    margin-bottom: 16px;
  }
  .st-p {
    max-width: 46ch;
  }
  .st-cap {
    margin-top: 10px;
    font-size: 14px;
    opacity: 0.75;
  }
  .st-art {
    color: inherit;
  }
  .st-art :global(.wall) {
    display: block;
    width: 100%;
    max-width: 640px;
    height: auto;
  }
  @media (max-width: 900px) {
    .st-wrap {
      padding-left: 32px;
    }
    .st-n {
      left: -33px;
      top: 6px;
    }
    .st,
    .st.flip,
    .st.tall,
    .st.tall.flip {
      grid-template-columns: minmax(0, 1fr);
    }
    .st.flip .st-t {
      order: 0;
    }
    .st.tall .st-img {
      width: 72%;
    }
    /* the address sits on the picture, so it never reads as a label over the next step's heading */
    .st-img {
      position: relative;
    }
    .st-cap {
      position: absolute;
      left: 8px;
      top: 8px;
      margin: 0;
      padding: 4px 8px;
      background: rgb(10 10 10 / 0.72);
      color: #fff;
      opacity: 1;
    }
    .st-list {
      gap: 72px;
    }
  }
</style>
