---
import Arrow from '../Arrow.astro';
/**
 * Lehi Light hero (research-premium §4.2): a 10 px black frame, the view panel (Sam's own Wasatch view as a film
 * that follows Lehi's clock) and the swatch nav column.
 * The still is the LCP: preloaded in <head>, never hidden. The opening sequence (letterbox, mark, title) is CSS
 * under html.op, set once per session in <head>; any input skips it; reduced motion never sees it.
 * The film is laid over the poster after load (it is frame 0 of the loop, so the cut is invisible).
 */
import { getImage } from 'astro:assets';
import Logo from '../Logo.astro';
import Skyline from '../Skyline.astro';
import { ZILLOW, CONTACT, BOOKING_URL, bookingAttrs, PODCAST } from '../../data/site';
import { HERO_VIEWS } from './hero-views';

// Film by Lehi time (film-plan §1.4, sun altitude from <head>). All four states are Sam's own Wasatch view
// (IG #13), animated or relit from his photograph (assets-gen/MEDIA-NOTES.md):
//   dawn, day, early golden → "Wasatch, golden light" loop (desktop 16:9, phone 9:16)
//   late golden (sun under 4°) → alpenglow still · blue hour → blue-hour still
//   night → night loop on desktop, the night still on phones (phone alternates are poster-only)
// Every still settles from 1.06 to 1.0 in code. The poster/still is always the LCP.
const set = async (src: ImageMetadata, ws: number[], format: 'avif' | 'webp') =>
  (await Promise.all(ws.filter((w) => w <= src.width).map(async (w) => `${(await getImage({ src, width: w, format, quality: 52 })).src} ${w}w`))).join(', ');
const sets: Record<string, { avif: string; webp: string; alt: string; film?: string }> = {};
for (const [k, v] of Object.entries(HERO_VIEWS)) sets[k] = { avif: await set(v.src, v.ws, 'avif'), webp: await set(v.src, v.ws, 'webp'), alt: v.alt, film: v.film };
const fallback = (await getImage({ src: HERO_VIEWS.golden.src, width: 1440, format: 'jpg', quality: 70 })).src;

const swatches = [
  { href: '/buy/', t: 'Buy', p: 'Know what you’re buying' },
  { href: '/sell/', t: 'Sell', p: 'Priced on numbers, not hope' },
  { href: '/invest/', t: 'Invest', p: 'Underwrite it like Sam' },
  { href: '/podcast/', t: 'Podcast', p: `Get Leveraged, ${PODCAST.episodes} episodes` },
];
---
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="view">
    <div class="still" data-still>
      <picture>
        <source type="image/avif" data-k="avif" sizes="(max-width: 900px) 100vw, 84vw" />
        <source type="image/webp" data-k="webp" sizes="(max-width: 900px) 100vw, 84vw" />
        <img width="1920" height="1080" alt="" fetchpriority="high" loading="eager" decoding="async" data-hero-img />
      </picture>
      <script is:inline define:vars={{ sets }}>
        // pick the still for Lehi's time of day before anything is fetched (html[data-sun] is set in <head>)
        (function () {
          var h = document.documentElement, s = h.dataset.sun, a = +h.dataset.alt, phone = matchMedia('(max-width: 900px)').matches;
          var v = s === 'night' ? 'night' : s === 'blue' ? 'blue' : s === 'golden' && a < 4 ? 'alpen' : 'golden';
          var k = (v === 'golden' || v === 'night') && phone ? v + 'Phone' : v, p = document.currentScript.previousElementSibling, img = p.querySelector('img');
          p.querySelectorAll('source').forEach(function (el) { el.srcset = sets[k][el.dataset.k]; });
          img.alt = sets[k].alt;
          h.dataset.view = v;
          var st = p.closest('[data-still]');
          st.dataset.view = v;
          if (sets[k].film) st.dataset.heroFilm = sets[k].film;
        })();
      </script>
      <noscript><img class="ns" src={fallback} alt={HERO_VIEWS.golden.alt} width="1920" height="1080" /></noscript>
    </div>
    <div class="shade" aria-hidden="true"></div>
    <a class="logo" href="/" aria-hidden="true" tabindex="-1"><Logo variant="caps" title="Sam Newell" /></a>
    <div class="name">
      <h1 class="title" id="hero-title"><span class="ln"><span>Sam</span></span> <span class="ln"><span>Newell</span></span></h1>
      <Skyline class="sky" draw="hero" />
    </div>
    <p class="sub">Realtor in Lehi, Utah. Buying, selling and investing on the Wasatch Front: <b class="num">{ZILLOW.sold}</b> homes sold, <b class="num">{ZILLOW.rating}</b> on <b class="num">{ZILLOW.reviews}</b> Zillow reviews.</p>
    <p class="sub-m">Realtor in Lehi, Utah · <b class="num">{ZILLOW.sold}</b> homes sold</p>
    <a class="btn act" href={BOOKING_URL} {...bookingAttrs}>Book a call with Sam <Arrow /></a>
    <p class="clock num" data-clock>Lehi, Utah</p>
    <!-- opening sequence (html.op only) -->
    <div class="op-cover" aria-hidden="true">
      <svg class="op-mark" viewBox="-10 -10 325.53 358.21" aria-hidden="true"><path pathLength="1" d="M0.00 243.37 L42.64 267.99 L42.64 135.72 L183.86 217.25 L183.86 267.65 L144.89 290.15 L104.47 266.82 L104.47 204.02 L63.21 180.20 L63.21 289.83 L147.01 338.21 L223.83 293.86 L223.83 237.86 L285.54 273.48 L285.54 136.96 L305.53 136.96 L305.53 91.70 L245.05 56.78 L245.05 203.23 L104.48 122.07 L104.48 71.40 L144.91 48.06 L183.86 70.55 L183.86 135.48 L223.83 158.56 L223.83 44.36 L146.99 0.00 L63.20 48.37 L63.20 99.32 L0.00 62.83 Z" /></svg>
    </div>
    <div class="lb lb-t" aria-hidden="true"></div>
    <div class="lb lb-b" aria-hidden="true"></div>
  </div>
  <nav class="swatches" aria-label="Sections">
    {swatches.map((s, i) => (
      <a class={`sw s${i + 1}`} href={s.href} style={`--i:${i}`}>
        <span class="sw-t">{s.t}</span>
        <span class="sw-p">{s.p}</span>
        <Skyline class="sw-sky" draw="hover" />
        <span class="sw-a" aria-hidden="true"><Arrow /></span>
      </a>
    ))}
    <a class="sw s5" href={BOOKING_URL} {...bookingAttrs} style="--i:4">
      <span class="sw-t">Book a call</span>
      <span class="sw-p num">{CONTACT.phone}</span>
      <span class="sw-a" aria-hidden="true"><Arrow /></span>
    </a>
  </nav>
</section>

<script>
  // Live Lehi clock; skip the opening on any input.
  const el = document.querySelector<HTMLElement>('[data-clock]');
  const tick = () => {
    const fixed = /[?&](t=|record)/.test(location.search);
    const now = fixed ? +(document.documentElement.dataset.t || Date.now()) : Date.now();
    const s = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Denver', hour: 'numeric', minute: '2-digit' }).format(now).replace(/\s?AM$/i, ' a.m.').replace(/\s?PM$/i, ' p.m.');
    if (el) el.textContent = `Lehi, ${s}`;
  };
  tick();
  setInterval(tick, 30_000);

  // The film for this hour: a muted, seamless loop (AV1 where the browser plays it, else H.264), started only after
  // the poster (LCP) has painted and the page has loaded; never with reduced motion or Save-Data; paused off-screen
  // and in hidden tabs. Its frame 0 is the poster, so it fades in without a cut.
  const still = document.querySelector<HTMLElement>('[data-still]');
  const nav = navigator as Navigator & { connection?: { saveData?: boolean } };
  const film = still?.dataset.heroFilm;
  if (still && film && !matchMedia('(prefers-reduced-motion: reduce)').matches && !nav.connection?.saveData) {
    const start = () => {
      const v = document.createElement('video');
      v.muted = true;
      v.loop = true;
      v.playsInline = true;
      v.setAttribute('playsinline', '');
      v.setAttribute('aria-hidden', 'true');
      v.preload = 'auto';
      v.className = 'film';
      const av1 = v.canPlayType('video/mp4; codecs="av01.0.08M.08"') === 'probably';
      v.src = `${film}${av1 ? '.av1' : ''}.mp4`;
      v.addEventListener('playing', () => v.classList.add('on'), { once: true });
      still.appendChild(v);
      v.play().catch(() => {});
      new IntersectionObserver(([e]) => (e.isIntersecting && !document.hidden ? v.play().catch(() => {}) : v.pause())).observe(still);
      document.addEventListener('visibilitychange', () => (document.hidden ? v.pause() : v.play().catch(() => {})));
    };
    // the poster is the LCP: the film waits for `load`, an idle moment and, on phones, a further beat, so its
    // bytes never compete with the first screen
    const later = () => {
      const idle = (fn: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 2000 }) : setTimeout(fn, 300));
      idle(() => setTimeout(start, matchMedia('(max-width: 900px)').matches ? 1200 : 300));
    };
    if (document.readyState === 'complete') later();
    else addEventListener('load', later, { once: true });
  }
  const html = document.documentElement;
  if (html.classList.contains('op')) {
    const skip = () => html.classList.add('op-skip');
    ['keydown', 'pointerdown', 'wheel', 'touchstart'].forEach((ev) => addEventListener(ev, skip, { once: true, passive: true }));
    setTimeout(() => html.classList.remove('op', 'op-skip'), 3200);
  }
</script>

<style>
  .hero {
    height: 100svh;
    min-height: min(640px, 100svh);
    max-height: 1200px;
    padding: 10px;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(220px, 1fr);
    grid-template-rows: minmax(0, 1fr);
    gap: 10px;
    background: #0a0a0a;
    color: #fff;
  }
  .view {
    position: relative;
    overflow: hidden;
    background: #141414;
    container-type: size;
  }
  .still {
    position: absolute;
    inset: 0;
  }
  .still :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .still :global(img),
  .still :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }
  .still :global(.ns) {
    position: absolute;
    inset: 0;
  }
  .still :global(.film) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.4s var(--ease-io);
  }
  .still :global(.film.on) {
    opacity: 1;
  }
  /* the settle (film-plan §1.0): the whole view, poster and film together, eases from 1.06 to 1.0; with the
     opening it lands as the letterbox opens. The camera in the films is locked off, so nothing else moves it. */
  @media (prefers-reduced-motion: no-preference) {
    .still {
      transform-origin: 50% 60%;
      animation: settle 3.2s var(--ease-expo) 0.1s both;
    }
    :global(html.op) .still {
      animation-delay: 0.9s;
    }
    @keyframes settle {
      from {
        transform: scale(1.06);
      }
    }
  }
  /* a neutral scrim only under the type: top for the name, bottom for the line, button and clock */
  .shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgb(0 0 0 / 0.38), rgb(0 0 0 / 0) 38%), /* taste-skill-ignore gradient: neutral scrim under text on a photo */
      linear-gradient(to top, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0) 34%); /* taste-skill-ignore gradient: neutral scrim under text on a photo */
  }
  .logo {
    position: absolute;
    top: 28px;
    left: 28px;
    z-index: 3;
    color: #fff;
  }
  .logo :global(svg) {
    height: 26px;
    width: auto;
  }
  /* the name, and under it the real Wasatch skyline drawn as one line (V2) */
  .name {
    position: absolute;
    left: 50%;
    top: 14%;
    z-index: 2;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .title {
    text-align: center;
    white-space: nowrap;
  }
  /* the signature under the name: the real profile, full white, tall enough to read as mountains */
  .name :global(.sky) {
    display: block;
    width: 100%;
    height: clamp(32px, 4.4vw, 64px);
    margin-top: 14px;
    color: #fff;
  }
  .name :global(.sky path) {
    stroke-width: 1.5;
  }
  /* V6: hovering a swatch traces the same skyline along its foot (fine pointers only; static on keyboard focus) */
  .sw :global(.sw-sky) {
    display: none;
    position: absolute;
    left: 20px;
    bottom: 26px;
    width: calc(100% - 96px);
    height: 18px;
    opacity: 0.7;
    pointer-events: none;
  }
  .s5 :global(.sw-sky) {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .sw :global(.sw-sky) {
      opacity: 0;
    }
    .sw:focus-visible :global(.sw-sky) {
      opacity: 1;
    }
  }
  @media (pointer: fine) and (min-width: 1024px) {
    .sw :global(.sw-sky) {
      display: block;
    }
  }
  .ln {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
    vertical-align: bottom;
  }
  .ln > span {
    display: inline-block;
  }
  .sub {
    position: absolute;
    left: 28px;
    bottom: 34px;
    z-index: 2;
    max-width: 420px;
    font-size: 18px;
    line-height: 1.5;
  }
  .sub b {
    font-weight: 600;
  }
  .act {
    position: absolute;
    left: 50%;
    bottom: 34px;
    z-index: 2;
    transform: translateX(-50%);
  }
  .act:active {
    transform: translateX(-50%) scale(0.97);
  }
  /* phones: the one line that says who Sam is (the full line is too long for the view) */
  .sub-m {
    display: none;
  }
  .clock {
    position: absolute;
    right: 28px;
    bottom: 40px;
    z-index: 2;
    font-size: 16px;
    font-weight: 500;
  }

  .swatches {
    display: grid;
    grid-template-rows: repeat(5, minmax(0, 1fr));
    min-height: 0;
  }
  .sw {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    padding: 22px 20px;
    text-decoration: none;
    color: #fff;
    transition: background-color 0.3s;
  }
  .s1 { background: #141414; }
  .s2 { background: #1c1c1c; }
  .s3 { background: #262626; }
  .s4 { background: #303030; }
  .s5 { background: #fff; color: #0a0a0a; }
  .s1:hover { background: #1c1c1c; }
  .s2:hover { background: #262626; }
  .s3:hover { background: #303030; }
  .s4:hover { background: #3a3a3a; }
  .s5:hover { background: #e6e6e6; }
  .sw-t {
    font-family: var(--display);
    font-weight: 500;
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  .sw-p {
    margin-top: 10px;
    font-size: 16px;
    line-height: 1.4;
    max-width: 17ch;
    transition: transform 0.4s var(--ease-out);
  }
  .sw-a {
    margin-top: auto;
    align-self: flex-end;
    font-size: 22px;
    transform: translateX(-8px);
    opacity: 0;
    transition: transform 0.4s var(--ease-out), opacity 0.3s;
  }
  .sw:hover .sw-p,
  .sw:focus-visible .sw-p {
    transform: translateX(6px);
  }
  .sw:hover .sw-a,
  .sw:focus-visible .sw-a {
    transform: none;
    opacity: 1;
  }
  .sw:active {
    filter: brightness(1.15);
  }
  .sw:focus-visible {
    outline: 3px solid #fff;
    outline-offset: -6px;
  }
  .s5:focus-visible {
    outline-color: #0a0a0a;
  }

  /* ——— opening sequence ——— */
  .op-cover,
  .lb {
    display: none;
  }
  :global(html.op) .op-cover {
    display: grid;
    place-items: center;
    position: absolute;
    inset: 0;
    z-index: 5;
    background: #0a0a0a;
    animation: op-fade 0.5s ease 0.75s forwards;
  }
  .op-mark {
    width: 64px;
    height: auto;
  }
  .op-mark path {
    fill: transparent;
    stroke: #fff;
    stroke-width: 6;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  :global(html.op) .op-mark path {
    animation: op-draw 0.6s ease-out forwards, op-fill 0.3s ease 0.45s forwards;
  }
  :global(html.op) .lb {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    z-index: 4;
    height: max(0px, calc((100cqh - 100cqw / 2.39) / 2));
    background: #0a0a0a;
    animation: op-bar 1.2s var(--ease-expo) 0.85s forwards;
  }
  .lb-t {
    top: 0;
    transform-origin: top;
  }
  .lb-b {
    bottom: 0;
    transform-origin: bottom;
  }
  :global(html.op) .ln > span {
    transform: translateY(105%);
    animation: op-rise 0.9s var(--ease-expo) forwards;
    animation-delay: 1.05s;
  }
  :global(html.op) .ln + .ln > span {
    animation-delay: 1.15s;
  }
  :global(html.op) .logo,
  :global(html.op) .sub,
  :global(html.op) .act,
  :global(html.op) .sub-m,
  :global(html.op) .clock {
    opacity: 0;
    animation: op-in 0.8s var(--ease-out) 1.5s forwards;
  }
  :global(html.op) .sw {
    opacity: 0;
    transform: translateX(28px);
    animation: op-step 0.8s var(--ease-expo) forwards;
    animation-delay: calc(1.2s + var(--i) * 0.09s);
  }
  :global(html.op-skip) .op-cover,
  :global(html.op-skip) .lb,
  :global(html.op-skip) .op-mark path,
  :global(html.op-skip) .ln > span,
  :global(html.op-skip) .logo,
  :global(html.op-skip) .sub,
  :global(html.op-skip) .act,
  :global(html.op-skip) .clock,
  :global(html.op-skip) .sub-m,
  :global(html.op-skip) .sw {
    animation-duration: 0.01s !important;
    animation-delay: 0s !important;
  }
  @keyframes op-draw { to { stroke-dashoffset: 0; } }
  @keyframes op-fill { to { fill: #fff; } }
  @keyframes op-fade { to { opacity: 0; visibility: hidden; } }
  @keyframes op-bar { to { transform: scaleY(0); } }
  @keyframes op-rise { to { transform: none; } }
  @keyframes op-in { to { opacity: 1; } }
  @keyframes op-step { to { opacity: 1; transform: none; } }

  /* narrow or short laptops: the line sits above the button, both on the left, so they never collide */
  @media (min-width: 901px) and (max-width: 1180px), (min-width: 901px) and (max-height: 760px) {
    .sub {
      bottom: 92px;
      font-size: 18px;
      max-width: 400px;
    }
    .act {
      left: 28px;
      bottom: 28px;
      transform: none;
    }
    .act:active {
      transform: scale(0.97);
    }
  }
  /* short laptops (1280×720, 1000×560): everything on the first screen; the swatches keep their titles only */
  @media (max-height: 760px) and (min-width: 901px) {
    .sw {
      padding: 14px 18px;
    }
    .sw-p {
      margin-top: 6px;
      font-size: 14px;
    }
  }
  @media (max-height: 640px) and (min-width: 901px) {
    .sw-p {
      display: none;
    }
    .name {
      top: max(9%, 64px);
    }
    .clock {
      bottom: 34px;
    }
  }
  @media (max-height: 600px) and (min-width: 901px) {
    .sub {
      bottom: 84px;
      max-width: 360px;
      font-size: 16px;
    }
  }

  @media (max-width: 900px) {
    .hero {
      height: auto;
      min-height: 0;
      max-height: none;
      grid-template-columns: 1fr;
      grid-template-rows: 64svh auto;
      padding: 8px;
      gap: 8px;
    }
    .view {
      min-height: 420px;
    }
    .logo {
      display: none;
    }
    .name {
      top: 9%;
      left: 16px;
      right: 16px;
      transform: none;
    }
    .title {
      font-size: clamp(60px, 16vw, 92px);
      white-space: normal;
      line-height: 0.95;
    }
    .name :global(.sky) {
      height: 32px;
      margin-top: 12px;
    }
    .sub {
      display: none;
    }
    .act {
      bottom: 24px;
      white-space: nowrap;
    }
    .sub-m {
      display: block;
      position: absolute;
      left: 16px;
      right: 16px;
      bottom: 88px;
      z-index: 2;
      text-align: center;
      font-size: 16px;
      font-weight: 500;
    }
    .sub-m b {
      font-weight: 600;
    }
    .clock {
      right: 16px;
      bottom: 124px;
      font-size: 14px;
    }
    .swatches {
      grid-template-rows: none;
    }
    .sw {
      flex-direction: row;
      align-items: center;
      gap: 14px;
      min-height: 56px;
      padding: 0 18px;
    }
    .sw-p {
      margin: 0;
      max-width: none;
    }
    .sw-a {
      margin: 0 0 0 auto;
      align-self: center;
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 420px) {
    .sw-p {
      display: none;
    }
  }
</style>
