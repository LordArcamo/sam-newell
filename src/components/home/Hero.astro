---
/**
 * Hero, frame 0 (SSR, no JS needed): poster <img> = LCP, never hidden or animated in.
 * Posters are captured FROM THE LIVE three.js RENDERER (scripts/capture-posters.mjs): 5 sun states × 3 rigs,
 * each rig a reference frame (desktop 2560×1440, tablet 1536×2048, phone 1170×2532) shown with a cover crop
 * centred on the frame. The live canvas (src/relief) renders the same reference frame and crops it the same way,
 * so the 1.2 s crossfade has no double image. GL MOUNT POINT: [data-relief-mount="hero"].
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ZILLOW, CONTACT, BOOKING_URL, bookingAttrs } from '../../data/site';
import posters from '../../data/posters.json';

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/posters/hero-*.jpg', { eager: true });
const STATES = ['dawn', 'noon', 'golden', 'blue', 'night'] as const;
const RIGS = {
  desktop: { w: [1280, 1920, 2560], media: '(min-aspect-ratio: 6/5)', sizes: 'max(100vw, 178svh)' },
  tablet: { w: [768, 1152, 1536], media: '(min-aspect-ratio: 3/4)', sizes: 'max(100vw, 75svh)' },
  phone: { w: [780, 1170], media: '', sizes: '100vw' },
} as const;
type Rig = keyof typeof RIGS;
const src = (state: string, rig: string) => files[`../../assets/posters/hero-${state}-${rig}.jpg`].default;
const set = async (state: string, rig: Rig, format: 'avif' | 'webp') =>
  (await Promise.all(RIGS[rig].w.map(async (w) => `${(await getImage({ src: src(state, rig), width: w, format, quality: format === 'avif' ? 50 : 68 })).src} ${w}w`))).join(', ');
const sets: Record<string, Record<string, { avif: string; webp: string }>> = {};
for (const st of STATES) {
  sets[st] = {};
  for (const rig of Object.keys(RIGS) as Rig[]) sets[st][rig] = { avif: await set(st, rig, 'avif'), webp: await set(st, rig, 'webp') };
}
const fallback = (await getImage({ src: src('noon', 'desktop'), width: 1920, format: 'jpg', quality: 72 })).src;
const plates = Object.fromEntries(Object.entries(posters.rigs).map(([rig, v]) => [rig, Object.fromEntries(Object.entries(v).map(([st, x]) => [st, x.plate]))]));
const sn = posters.rigs.desktop.golden.sn ?? { fx: 0.32, fy: 0.47 };
const order: Rig[] = ['desktop', 'tablet', 'phone'];
---
<section class="hero" data-hero aria-labelledby="hero-title" style={`--snx:${(sn.fx * 100).toFixed(2)}%;--sny:${(sn.fy * 100).toFixed(2)}%`}>
  <div class="hero-media" data-relief-mount="hero">
    <div class="frame" data-hero-frame>
      <picture data-hero-poster>
        {order.map((rig) => (
          <>
            <source type="image/avif" sizes={RIGS[rig].sizes} media={RIGS[rig].media || undefined} data-rig={rig} />
            <source type="image/webp" sizes={RIGS[rig].sizes} media={RIGS[rig].media || undefined} data-rig={rig} />
          </>
        ))}
        <img
          width="2560"
          height="1440"
          alt="A white plaster relief model of the Wasatch Front seen from above Utah Lake, with Sam's homes pinned and the SN mark standing at Lehi"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </picture>
      <script is:inline define:vars={{ sets, plates, fallback }}>
        // Bucket the poster by the real sun over Lehi (html[data-sun], set in <head>) before anything is fetched,
        // so only one poster ever downloads.
        (function () {
          var s = document.documentElement.dataset.sun || 'noon', p = document.currentScript.previousElementSibling;
          p.querySelectorAll('source').forEach(function (el) {
            el.srcset = sets[s][el.dataset.rig][el.type === 'image/avif' ? 'avif' : 'webp'];
          });
          p.querySelector('img').src = fallback;
          var rig = matchMedia('(min-aspect-ratio: 6/5)').matches ? 'desktop' : matchMedia('(min-aspect-ratio: 3/4)').matches ? 'tablet' : 'phone';
          if (plates[rig] && plates[rig][s]) p.closest('[data-hero]').classList.add('plate');
        })();
      </script>
      <noscript><img class="noscript-poster" src={fallback} width="2560" height="1440" alt="A white plaster relief model of the Wasatch Front seen from above Utah Lake" /></noscript>
    </div>
  </div>
  <p class="caption small" data-caption>Lehi, Utah</p>
  <script is:inline>
    (function () {
      var t = +document.documentElement.dataset.t || Date.now();
      var s = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Denver', hour: 'numeric', minute: '2-digit' }).format(t)
        .replace(/\s?AM$/i, ' a.m.').replace(/\s?PM$/i, ' p.m.');
      document.currentScript.previousElementSibling.textContent = 'Lehi now, ' + s;
    })();
  </script>
  <div class="hero-foot">
    <h1 class="title" id="hero-title">Sam<br /> Newell</h1>
    <div class="side">
      <p class="sentence">Real estate broker in Lehi, Utah. Buying, selling and investing on the Wasatch Front, with straight answers.</p>
      <p class="proof num"><b>{ZILLOW.rating}</b> from {ZILLOW.reviews} Zillow reviews · <b>{ZILLOW.sold}</b> homes sold</p>
      <a class="btn" href={BOOKING_URL} {...bookingAttrs}>Book a call with Sam <span class="arrow" aria-hidden="true">→</span></a>
      <p class="tel"><a href={CONTACT.phoneHref}>or call or text {CONTACT.phone}</a></p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: calc(100svh - var(--bar));
    min-height: 620px;
    max-height: 1100px;
    overflow: hidden;
    background: var(--tone);
  }
  .hero-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    container-type: size;
    --r: 0.4621; /* phone rig 1170 × 2532 */
    --px: 0.5;
  }
  @media (min-aspect-ratio: 3/4) {
    .hero-media {
      --r: 0.75; /* tablet rig 1536 × 2048 */
    }
  }
  @media (min-aspect-ratio: 6/5) {
    .hero-media {
      --r: 1.7778; /* desktop rig 2560 × 1440 */
    }
  }
  /* The poster frame reproduces object-fit: cover with object-position (px, 60%), so DOM markers and the
     future GL view offset share one crop. */
  .frame {
    position: absolute;
    width: max(100cqw, 100cqh * var(--r));
    height: max(100cqh, 100cqw / var(--r));
    left: clamp(100cqw - max(100cqw, 100cqh * var(--r)), 50cqw - var(--px) * max(100cqw, 100cqh * var(--r)), 0px);
    top: calc((100cqh - max(100cqh, 100cqw / var(--r))) * 0.5);
  }
  .frame img {
    width: 100%;
    height: 100%;
  }
  .frame img:not([src]) {
    visibility: hidden;
  }
  .noscript-poster {
    position: absolute;
    inset: 0;
  }
  /* Gallery-white rule (model check I-1): a solid plate behind the title when the measured contrast < 4.5:1 */
  .hero.plate .title {
    justify-self: start;
    background: var(--paper);
    padding: 0.08em 0.1em 0.04em;
  }
  :global([data-sun='night']) .title {
    color: var(--paper);
  }
  :global([data-sun='night']) .hero {
    background: var(--ink);
  }
  .caption {
    position: absolute;
    z-index: 2;
    top: 20px;
    right: var(--m);
    background: var(--paper);
    padding: 6px 10px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .hero-foot {
    position: absolute;
    z-index: 2;
    inset: auto 0 0 0;
    padding: 0 var(--m) 28px;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 40px;
    pointer-events: none;
  }
  .hero-foot > * {
    pointer-events: auto;
  }
  .title {
    color: var(--ink);
  }
  .side {
    width: min(420px, 34vw);
    background: var(--paper);
    padding: 24px 24px 24px;
    margin-bottom: 4px;
  }
  .sentence {
    font-weight: 500;
    margin-bottom: 16px;
  }
  .proof {
    font-size: 16px;
    margin-bottom: 20px;
  }
  .proof b {
    font-weight: 600;
  }
  .side .btn {
    width: 100%;
  }
  .tel {
    margin-top: 10px;
    text-align: center;
    font-size: 16px;
  }
  .tel a {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    display: inline-block;
    padding: 8px 0;
  }
  @media (max-width: 1023px) {
    .side {
      width: 360px;
    }
  }
  @media (max-width: 767px) {
    .hero {
      height: auto;
      min-height: 0;
      max-height: none;
      overflow: visible;
      background: var(--paper);
    }
    .hero {
      --hh: max(68svh, 440px);
    }
    .hero-media {
      position: relative;
      height: var(--hh);
    }
    .caption {
      top: 14px;
    }
    .hero-foot {
      position: static;
      grid-template-columns: 1fr;
      gap: 0;
      padding: 0;
    }
    .title {
      position: absolute;
      z-index: 2;
      left: var(--m);
      top: calc(var(--hh) - 14px);
      transform: translateY(-100%);
      font-size: min(25vw, 140px);
    }
    .side {
      width: auto;
      padding: 24px var(--m) 8px;
      margin: 0;
    }
  }
</style>
