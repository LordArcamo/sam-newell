---
/** <head>: preload exactly the hero still this visitor will see (day film poster or dusk photo × phone/desktop). */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import dusk from '../../assets/photos/wasatch-dusk.jpg';
import dayDesk from '../../assets/film/hero-desktop.jpg';
import dayPhone from '../../assets/film/hero-phone.jpg';
const set = async (src: ImageMetadata, ws: number[]) =>
  (await Promise.all(ws.filter((w) => w <= src.width).map(async (w) => `${(await getImage({ src, width: w, format: 'avif', quality: 66 })).src} ${w}w`))).join(', ');
const pre = { dusk: await set(dusk, [720, 1080, 1440, 1920, 2400]), day: await set(dayDesk, [720, 1080]), dayPhone: await set(dayPhone, [480, 720]) };
---
<script is:inline define:vars={{ pre }}>
  (function (d) {
    var s = d.documentElement.dataset.sun, day = s === 'noon' || s === 'dawn', phone = matchMedia('(max-width: 900px)').matches;
    var l = d.createElement('link');
    l.rel = 'preload'; l.as = 'image'; l.type = 'image/avif'; l.setAttribute('fetchpriority', 'high');
    l.setAttribute('imagesrcset', pre[day ? (phone ? 'dayPhone' : 'day') : 'dusk']);
    l.setAttribute('imagesizes', '(max-width: 900px) 100vw, 84vw');
    d.head.appendChild(l);
  })(document);
</script>
