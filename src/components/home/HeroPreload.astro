---
/** <head>: preload exactly the hero poster this visitor will see (the hour's view × phone/desktop, as Hero.astro picks it). */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { HERO_VIEWS } from './hero-views';
const set = async (src: ImageMetadata, ws: number[]) =>
  (await Promise.all(ws.filter((w) => w <= src.width).map(async (w) => `${(await getImage({ src, width: w, format: 'avif', quality: 52 })).src} ${w}w`))).join(', ');
const pre: Record<string, string> = {};
for (const [k, v] of Object.entries(HERO_VIEWS)) pre[k] = await set(v.src, v.ws);
---
<script is:inline define:vars={{ pre }}>
  (function (d) {
    var h = d.documentElement, s = h.dataset.sun, a = +h.dataset.alt, phone = matchMedia('(max-width: 900px)').matches;
    var v = s === 'night' ? 'night' : s === 'blue' ? 'blue' : s === 'golden' && a < 4 ? 'alpen' : 'golden';
    var l = d.createElement('link');
    l.rel = 'preload'; l.as = 'image'; l.type = 'image/avif'; l.setAttribute('fetchpriority', 'high');
    l.setAttribute('imagesrcset', pre[(v === 'golden' || v === 'night') && phone ? v + 'Phone' : v]);
    l.setAttribute('imagesizes', '(max-width: 900px) 100vw, 84vw');
    d.head.appendChild(l);
  })(document);
</script>
