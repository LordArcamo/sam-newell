---
/**
 * The map — the live thing. Works today in its no-GPU mode: an SVG contour relief built from the same USGS DEM
 * as the model, 12 town buttons (toolbar, roving tabindex), pins as real buttons, a card per town, deep links
 * (/?town=slug#map) and the calculator sheet. GL MOUNT POINT: [data-relief-mount="map"]; when mountRelief()
 * returns a handle, map-ui.ts forwards the same selections to handle.fly() and positions pins via handle.project().
 */
import Pic from '../Pic.astro';
import Logo from '../Logo.astro';
import Calc from '../Calc.astro';
import { TOWNS, HOMES } from '../../lib/homes';
import { REVIEWS, reviewDate } from '../../data/reviews';
import { img } from '../../lib/images';
import { ZILLOW } from '../../data/site';

const DEFAULT = 'lehi';
const cards = TOWNS.map((t) => {
  const homes = HOMES.filter((h) => h.group === t.slug).sort((a, b) => ['for-sale', 'sold', 'past'].indexOf(a.status) - ['for-sale', 'sold', 'past'].indexOf(b.status));
  const n = (s: string) => homes.filter((h) => h.status === s).length;
  const parts = [n('for-sale') && `${n('for-sale')} for sale`, n('sold') && `${n('sold')} sold lately`, n('past') && `${n('past')} past ${n('past') > 1 ? 'listings' : 'listing'}`].filter(Boolean);
  const lead = homes.find((h) => h.photo && h.photoKind === 'exterior'); // the card shows a house, never a kitchen
  const rv = t.review ? REVIEWS.find((r) => r.n === t.review) : null;
  return { ...t, homes, count: parts.join(' · '), lead, rv };
});
// the town slips along the bottom (research §4.5): the towns with homes on the map, Lehi first
const SLIP_ORDER = ['lehi', 'north-salt-lake', 'provo', 'eagle-mountain', 'orem', 'saratoga-springs', 'pleasant-grove', 'american-fork'];
const slips = SLIP_ORDER.map((slug) => cards.find((c) => c.slug === slug)!).filter((c) => c && c.homes.length);
const pins = HOMES.filter((h) => h.xy).sort((a, b) => b.xy!.north - a.xy!.north);
const lehi = TOWNS.find((t) => t.slug === 'lehi')!;
const mapData = {
  towns: TOWNS.map((t) => ({ slug: t.slug, x: t.x, y: -t.north })),
  pins: pins.map((h) => ({ id: h.id, town: h.group, x: h.xy!.x, y: -h.xy!.north, s: h.status })),
  sn: { x: lehi.x, y: -lehi.north },
};
---
<section class="map" id="map" aria-labelledby="map-h" data-map>
  <!-- Desktop: a split view. Left: the heading and the towns, then the picked town's card (it scrolls on its own, its
       actions pinned at its foot). Right: the map, never covered. DOM order = tab order = reading order: towns, card,
       then the pins (one stop).
       Below 900 px (portrait tablets, phones) it stacks: heading, map, towns, card. -->
  <div class="rail" data-rail>
    <div class="copy" data-towns>
      <h2 class="copy-h" id="map-h">Pick your town</h2>
      <p class="copy-lead">Every pin is a home Sam has listed or sold.<span class="lead-2"> Tap a town and the model flies there.</span></p>
    </div>
    <div class="slips num" role="toolbar" aria-label="Towns" aria-orientation="horizontal" data-toolbar>
      {slips.map((c) => (
        <button type="button" class="slip" data-town={c.slug} aria-pressed={c.slug === DEFAULT ? 'true' : 'false'} tabindex={c.slug === DEFAULT ? 0 : -1} aria-controls="map-card">
          <b>{c.name}</b>
          <span>{c.homes.length}<span class="sr-only"> {c.homes.length === 1 ? 'home' : 'homes'}</span></span>
        </button>
      ))}
    </div>
  </div>

  <div class="card dark" id="map-card" data-cards>
    <p class="sr-only" aria-live="polite" data-announce></p>
    {cards.map((c) => (
      <article class:list={['tc', { on: c.slug === DEFAULT }]} data-card={c.slug} aria-labelledby={`tc-${c.slug}`}>
        {c.lead?.photo ? (
          <Pic src={img(`listings/${c.lead.photo}`)} alt={`${c.lead.shown}, ${c.lead.townName}`} sizes="390px" ratio="r169" rv={false} widths={[390, 550]} />
        ) : (
          <div class="macro r169" aria-hidden="true">
            <svg viewBox={`${c.x - 4} ${-c.north - 2.67} 8 5.33`} preserveAspectRatio="xMidYMid slice"><use data-href="/map/relief-dark.svg#relief-geo" /></svg>
            {c.homes.filter((h) => h.xy).map((h) => (
              <i style={`left:${((h.xy!.x - (c.x - 4)) / 8) * 100}%;top:${((-h.xy!.north - (-c.north - 2.67)) / 5.33) * 100}%`}></i>
            ))}
          </div>
        )}
        <div class="tc-body">
          <div class="tc-head">
            <h3 class="tc-town" id={`tc-${c.slug}`}>{c.name}</h3>
            <p class="small">{c.count || 'No homes shown here yet.'}</p>
          </div>
          <!-- on desktop the card scrolls on its own and the actions stick to its foot, so they never leave the screen -->
          <div class="tc-scroll">
            {c.homes.length > 0 ? (
              <ul role="list" class="tc-homes">
                {c.homes.slice(0, 3).map((h) => (
                  <li data-home={h.id}>
                    <a href={h.zillow} rel="noopener" target="_blank">
                      <span class="addr">{h.shown}</span>
                      <span class="det num">{h.detail}</span>
                    </a>
                    {h.status === 'for-sale' && <button type="button" class="run small" data-run={h.price}>Run the numbers</button>}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="empty">Ask Sam about {c.name}.</p>
            )}
            {c.homes.length > 3 && <p class="small tc-more">{c.homes.length - 3} more on the map and <a href={ZILLOW.profile} rel="noopener" target="_blank">on Zillow</a></p>}
            {c.rv && (
              <figure class="tc-q small">
                <blockquote><p>“{c.rv.excerpts.town}”</p></blockquote>
                <figcaption>{c.rv.name}, {reviewDate(c.rv.date)}, on Zillow. <a href={`/reviews/#review-${c.rv.n}`} aria-label={`Read ${c.rv.name}'s full review`}>Read</a></figcaption>
              </figure>
            )}
          </div>
          <div class="tc-act">
            <button type="button" class="btn light" data-run={c.homes.find((h) => h.status === 'for-sale')?.price ?? ''}>Run the numbers</button>
            <a class="btn ghost" href={ZILLOW.profile} rel="noopener" target="_blank">See on Zillow</a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="stage" data-relief-mount="map" data-stage>
    <!-- V3: the real USGS contours around Lehi (every 250 m, sorted by distance from Lehi), drawn outward as the
         chapter arrives; the model then crossfades in over them. The paths load lazily (map-ui.ts), not in the HTML. -->
    <svg class="line-art topo" viewBox="-16 -26 36 38" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false" data-topo>
      <circle class="home" cx="0" cy="0" r="0.42" />
    </svg>
    <svg class="relief" viewBox="-30 -56 64 40" preserveAspectRatio="none" data-ui data-map-svg role="img" aria-label="Contour map of the Wasatch Front from North Salt Lake to Provo, with Utah Lake and the Great Salt Lake">
      <use data-href="/map/relief-dark.svg#relief-geo" />
    </svg>
    <div class="overlay" aria-hidden="true" data-labels data-ui>
      {TOWNS.map((t) => <span class="tl small" data-label={t.slug}>{t.name}</span>)}
      <span class="sn" data-sn><Logo variant="mark" title="" /></span>
    </div>
    <button type="button" class="full" data-full hidden>Full map</button>
    <!-- one tab stop: after the towns and the card, the pins are a single roving group (arrows move, Enter opens) -->
    <p class="sr-only" id="pins-hint">Use the arrow keys to move between homes. Enter shows the home's town.</p>
    <div class="pins" role="toolbar" aria-label="Sam's homes on the map" aria-describedby="pins-hint" data-pins>
      {pins.map((h, i) => (
        <button type="button" class:list={['pin', h.status]} data-pin={h.id} data-town={h.group} aria-label={h.label} tabindex={i === 0 ? 0 : -1}>
          <i aria-hidden="true"></i>
          <span class="tag small" aria-hidden="true">{h.shown}, {h.townName}</span>
        </button>
      ))}
    </div>
  </div>


  <dialog class="sheet" aria-labelledby="sheet-h" data-sheet>
    <div class="sheet-top">
      <h2 class="sheet-h" id="sheet-h">Underwrite it like Sam</h2>
      <button type="button" class="sheet-x" data-sheet-close>Close</button>
    </div>
    <p class="sheet-note small" data-sheet-note>Example numbers. Change any of them.</p>
    <Calc id="calc-map" mode="invest" compact />
  </dialog>

  <script type="application/json" data-map-json set:html={JSON.stringify(mapData)} />
</section>

<style>
  /* ——— layout. Desktop: rail | map, side by side, nothing over the map (user test 2026-10-21: the plate, card and
     slips left ~20% of the map visible on a 1000×540 laptop). ——— */
  .map {
    position: relative;
    display: grid;
    grid-template-columns: minmax(360px, 34%) minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
    height: calc(100svh - var(--bar));
    min-height: 460px;
    overflow: hidden;
    background: #0a0a0a;
    scroll-margin-top: -16px; /* lands right under the bar (html scroll-padding is bar + 16) */
  }
  .rail {
    grid-column: 1;
    grid-row: 1;
    padding: 40px 20px 0 var(--m);
  }
  .stage {
    grid-column: 2;
    grid-row: 1 / 3;
    position: relative;
    overflow: hidden;
    z-index: 0; /* its own stack: contours, canvas, route and pins */
  }

  /* ——— the rail ——— */
  .copy-h {
    font-size: clamp(36px, 3.334vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 400;
  }
  .copy-lead {
    margin-top: 12px;
    font-size: 17px;
    line-height: 1.45;
    max-width: 38ch;
  }
  /* the towns: compact chips (name + homes on the map), the picked one turns white */
  .slips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 24px;
  }
  .slip {
    display: inline-flex;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    align-items: center;
    background: #1c1c1c;
    color: #fff;
    transition: background-color var(--hover), color var(--hover);
  }
  .slip b {
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
  }
  .slip > span {
    font-size: 14px;
    opacity: 0.7;
  }
  .slip:hover {
    background: #2e2e2e;
  }
  .slip[aria-pressed='true'] {
    background: #fff;
    color: #0a0a0a;
  }
  .slip:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }
  /* the card: as tall as it needs, up to the room left under the towns; then it scrolls, actions pinned at its foot */
  .card {
    grid-column: 1;
    grid-row: 2;
    align-self: start;
    max-height: calc(100% - 20px - 28px);
    margin: 20px 20px 0 var(--m);
    overflow-y: auto; /* no overscroll containment: at its end the wheel carries on to the page */
    scrollbar-width: thin;
  }

  /* ——— the map stage ——— */
  .relief {
    width: 100%;
    height: 100%;
    transition: opacity 0.6s var(--ease-io);
  }
  .topo {
    position: absolute;
    inset: 6%;
    z-index: 1;
    color: #fff;
    pointer-events: none;
    overflow: hidden;
    transition: opacity 0.6s var(--ease-io);
  }
  .topo path.minor {
    stroke-opacity: 0.55;
    stroke-width: 1;
  }
  .topo .home {
    fill: #fff;
    stroke: none;
  }
  /* until the contours have drawn, the model and the flat relief wait; after, the contours give way */
  .map:global(.hold) .relief,
  .map:global(.hold) :global(.relief-canvas.on),
  .map:global(.hold) .pins,
  .map:global(.hold) .overlay {
    opacity: 0;
  }
  .map:not(:global(.hold)) .topo {
    opacity: 0;
  }
  /* while the contours draw, the pins are not there to tab to either */
  .map:global(.hold) .pins {
    visibility: hidden;
  }
  .pins,
  .overlay {
    transition: opacity 0.6s var(--ease-io);
  }
  /* V5: the line from Lehi to the picked town (map-ui.ts) */
  .stage :global(.route) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    overflow: visible;
  }
  .stage :global(.route line) {
    stroke: #fff;
    stroke-width: 1.25;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .map:not(:global(.is-gl)) .stage :global(.route) {
    display: none;
  }
  .overlay,
  .pins {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  .tl {
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 600;
    white-space: nowrap;
    padding: 2px 6px;
    background: var(--paper);
    transform: translate(10px, -50%);
    transition: background-color var(--hover), color var(--hover);
  }
  .tl.on {
    background: var(--ink);
    color: var(--paper);
  }
  .sn {
    position: absolute;
    left: 0;
    top: 0;
    width: 30px;
    transform: translate(-50%, -100%);
  }
  .sn :global(svg) {
    width: 30px;
    height: auto;
  }
  .pin {
    position: absolute;
    left: 0;
    top: 0;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    display: grid;
    place-items: center;
    pointer-events: auto;
  }
  .pin i {
    display: block;
    width: 12px;
    height: 12px;
    background: var(--ink);
    border-radius: 50%;
    outline: 2px solid var(--paper);
    transition: transform var(--hover) var(--ease-out);
  }
  .pin.for-sale i {
    border-radius: 0;
    width: 13px;
    height: 13px;
  }
  .pin:hover i,
  .pin:focus-visible i,
  .pin.on i {
    transform: scale(1.4);
  }
  .pin:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 1px;
    border-radius: 50%;
  }
  .tag {
    position: absolute;
    left: 50%;
    bottom: calc(100% - 4px);
    transform: translate(-50%, 4px);
    background: var(--ink);
    color: var(--paper);
    padding: 4px 8px;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--hover), transform var(--hover) var(--ease-out);
  }
  .pin:hover .tag,
  .pin:focus-visible .tag,
  .pin.on .tag,
  .map.is-town .pin .tag {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  /* phones: a town's tags would stack on each other; the card lists them, a pin shows its own on tap or focus */
  @media (max-width: 599px) {
    .map.is-town .pin:not(.on, :focus-visible, :hover) .tag {
      opacity: 0;
    }
  }
  /* a tag that would overlap a more important one waits for hover or focus (map-ui.ts declutter) */
  .map.is-town .pin:global(.mute):not(.on, :focus-visible, :hover) .tag {
    opacity: 0;
  }
  /* tags never run off the stage sideways */
  .pin.flip .tag,
  .map.is-town .pin.flip .tag {
    left: auto;
    right: 50%;
    transform: translate(12px, 0);
  }
  .pin.flop .tag,
  .map.is-town .pin.flop .tag {
    left: 50%;
    transform: translate(-12px, 0);
  }
  /* live relief: labels and the SN mark are in the model; the SVG stays underneath as the poster */
  .map.is-gl .overlay {
    display: none;
  }
  .map.is-gl .pin i,
  .map.is-gl .pin:hover i,
  .map.is-gl .pin:focus-visible i,
  .map.is-gl .pin.on i {
    opacity: 0;
  }
  /* back out to the whole valley (only while a town is picked) */
  .full {
    position: absolute;
    right: 16px;
    top: 16px;
    z-index: 3;
    min-height: 44px;
    padding: 0 16px;
    background: #fff;
    color: #0a0a0a;
    font-weight: 600;
    font-size: 15px;
  }
  .full:hover {
    background: #e6e6e6;
  }
  .full:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  /* ——— the town card ——— */
  :global(.js) .tc {
    display: none;
  }
  :global(.js) .tc.on {
    display: block;
    animation: card-in 0.15s ease-out;
  }
  @keyframes card-in {
    from {
      opacity: 0;
    }
  }
  .macro {
    position: relative;
    background: var(--paper);
    overflow: hidden;
  }
  .macro svg {
    width: 100%;
    height: 100%;
  }
  .macro i {
    position: absolute;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    background: var(--ink);
    border-radius: 50%;
    outline: 2px solid var(--paper);
  }
  .tc-body {
    --pad: 22px;
    padding: 20px var(--pad) 0;
  }
  .tc-town {
    font-size: 32px;
    letter-spacing: -0.025em;
  }
  .tc-homes {
    margin: 14px 0 0;
    display: grid;
    gap: 4px;
  }
  .tc-homes li {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 6px 12px;
    padding: 6px 8px;
    margin: 0 -8px;
    transition: background-color var(--hover);
  }
  .tc-homes li.on {
    background: #ececec;
  }
  .tc-homes a {
    text-decoration: none;
    display: grid;
  }
  .tc-homes a:hover .addr {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .addr {
    font-family: var(--display);
    font-weight: 600;
    font-size: 22px;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .det {
    font-size: 16px;
  }
  .run {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    color: var(--paper);
    min-height: 44px;
  }
  .empty {
    margin-top: 12px;
  }
  .tc-more {
    margin-top: 6px;
    font-weight: 400;
  }
  .tc-more a {
    font-weight: 600;
  }
  .card :global(.r169) {
    aspect-ratio: 21 / 9;
  }
  .tc-q {
    margin: 16px 0 4px;
  }
  /* long quotes stop at three lines; "Read" opens the whole review */
  .tc-q blockquote p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .tc-q figcaption {
    margin-top: 6px;
    font-weight: 400;
  }
  .tc-q figcaption a {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    display: inline-block;
    min-height: 24px;
  }
  /* the actions stick to the card's foot while it runs on below; then they sit on a grey plate */
  .tc-act {
    position: sticky;
    bottom: 0;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    background: #fff;
    margin: 0 calc(-1 * var(--pad));
    padding: 16px var(--pad) var(--pad);
    transition: background-color var(--hover);
  }
  .card:global(.is-cut) .tc-act {
    background: #efefef;
  }
  .card:global(.is-cut) .tc-act .btn.ghost {
    background: #fff;
  }
  .tc-act .btn {
    min-height: 48px;
    padding: 0 16px;
    font-size: 16px;
  }
  .btn.ghost {
    background: #ececec;
    color: #0a0a0a;
  }
  .btn.ghost:hover {
    background: #d9d9d9;
  }
  /* short screens: the card drops its picture so the list and the actions come first */
  @media (min-width: 900px) and (max-height: 820px) {
    .card :global(.ph),
    .card .macro {
      display: none;
    }
  }
  /* very short screens: one line of lead, tighter rail */
  @media (min-width: 900px) and (max-height: 700px) {
    .rail {
      padding-top: 18px;
    }
    .copy-h {
      font-size: 32px;
    }
    /* the lead and the chip counts step aside (the card says the same); room goes to the homes */
    .copy-lead {
      display: none;
    }
    .slips {
      margin-top: 12px;
      gap: 4px;
    }
    .slip {
      min-height: 32px;
      padding: 0 9px;
    }
    .slip b {
      font-size: 14px;
    }
    .slip > span {
      display: none;
    }
    .card {
      margin-top: 12px;
      max-height: calc(100% - 12px - 16px);
    }
    .tc-body {
      --pad: 16px;
      padding-top: 12px;
    }
    .tc-town {
      font-size: 24px;
    }
    .tc-head .small {
      font-size: 13px;
    }
    /* compact home rows: address and price on one line, so two or three homes show above the actions */
    .tc-homes {
      margin-top: 8px;
      gap: 0;
    }
    .tc-homes li {
      padding: 2px 8px;
    }
    .tc-homes a {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: 8px;
    }
    .addr {
      font-size: 17px;
    }
    .det {
      font-size: 14px;
    }
    .run {
      font-size: 14px;
      min-height: 36px;
    }
    .tc-more,
    .tc-q {
      font-size: 14px;
    }
    /* the pinned actions stay one short row: the Zillow link drops its plate */
    .tc-act {
      flex-wrap: nowrap;
      align-items: center;
      gap: 14px;
      padding-top: 8px;
      padding-bottom: 12px;
    }
    .tc-act .btn {
      min-height: 40px;
      padding: 0 14px;
      font-size: 15px;
      white-space: nowrap;
    }
    .tc-act .btn.ghost,
    .card:global(.is-cut) .tc-act .btn.ghost {
      background: none;
      padding: 0 2px;
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }
  }

  .sheet {
    margin: auto 0 auto auto;
    height: 100dvh;
    max-height: 100dvh;
    width: min(760px, 100vw);
    max-width: 100vw;
