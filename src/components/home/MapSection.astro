---
/**
 * The map — the live thing. Works today in its no-GPU mode: an SVG contour relief built from the same USGS DEM
 * as the model, 12 town buttons (toolbar, roving tabindex), pins as real buttons, a card per town, deep links
 * (/?town=slug#map) and the calculator sheet. GL MOUNT POINT: [data-relief-mount="map"]; when mountRelief()
 * returns a handle, map-ui.ts forwards the same selections to handle.fly() and positions pins via handle.project().
 */
import Pic from '../Pic.astro';
import Logo from '../Logo.astro';
import Calc from '../Calc.astro';
import { TOWNS, HOMES } from '../../lib/homes';
import { REVIEWS, reviewDate } from '../../data/reviews';
import { img } from '../../lib/images';
import { ZILLOW } from '../../data/site';
import contours from '../../data/lines/contours.json';

const DEFAULT = 'lehi';
const cards = TOWNS.map((t) => {
  const homes = HOMES.filter((h) => h.group === t.slug).sort((a, b) => ['for-sale', 'sold', 'past'].indexOf(a.status) - ['for-sale', 'sold', 'past'].indexOf(b.status));
  const n = (s: string) => homes.filter((h) => h.status === s).length;
  const parts = [n('for-sale') && `${n('for-sale')} for sale`, n('sold') && `${n('sold')} sold lately`, n('past') && `${n('past')} past ${n('past') > 1 ? 'listings' : 'listing'}`].filter(Boolean);
  const lead = homes.find((h) => h.photo && h.photoKind === 'exterior'); // the card shows a house, never a kitchen
  const rv = t.review ? REVIEWS.find((r) => r.n === t.review) : null;
  return { ...t, homes, count: parts.join(' · '), lead, rv };
});
// the town slips along the bottom (research §4.5): the towns with homes on the map, Lehi first
const SLIP_ORDER = ['lehi', 'north-salt-lake', 'provo', 'eagle-mountain', 'orem', 'saratoga-springs', 'pleasant-grove', 'american-fork'];
const slips = SLIP_ORDER.map((slug) => cards.find((c) => c.slug === slug)!).filter((c) => c && c.homes.length);
const pins = HOMES.filter((h) => h.xy).sort((a, b) => b.xy!.north - a.xy!.north);
const lehi = TOWNS.find((t) => t.slug === 'lehi')!;
const mapData = {
  towns: TOWNS.map((t) => ({ slug: t.slug, x: t.x, y: -t.north })),
  pins: pins.map((h) => ({ id: h.id, town: h.group, x: h.xy!.x, y: -h.xy!.north, s: h.status })),
  sn: { x: lehi.x, y: -lehi.north },
};
---
<section class="map" id="map" aria-labelledby="map-h" data-map>
  <div class="stage" data-relief-mount="map" data-stage>
    <!-- V3: the real USGS contours around Lehi (every 250 m, sorted by distance from Lehi), drawn outward as the
         chapter arrives; the model then crossfades in over them (motion.ts [data-draw="topo"]). -->
    <svg class="line-art topo" viewBox="-16 -26 36 38" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false" data-draw="topo">
      {contours.map((c) => <path d={c.d} class:list={{ minor: !c.major }} />)}
      <circle class="home" cx="0" cy="0" r="0.42" />
    </svg>
    <svg class="relief" viewBox="-30 -56 64 40" preserveAspectRatio="none" data-ui data-map-svg role="img" aria-label="Contour map of the Wasatch Front from North Salt Lake to Provo, with Utah Lake and the Great Salt Lake">
      <use href="/map/relief-dark.svg#relief-geo" />
    </svg>
    <div class="overlay" aria-hidden="true" data-labels data-ui>
      {TOWNS.map((t) => <span class="tl small" data-label={t.slug}>{t.name}</span>)}
      <span class="sn" data-sn><Logo variant="mark" title="" /></span>
    </div>
    <ul class="pins" role="list" aria-label="Sam's homes on the map" data-pins>
      {pins.map((h) => (
        <li>
          <button type="button" class:list={['pin', h.status]} data-pin={h.id} data-town={h.group} aria-label={h.label}>
            <i aria-hidden="true"></i>
            <span class="tag small" aria-hidden="true">{h.shown}, {h.townName}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <div class="copy" data-towns>
    <h2 class="h copy-h" id="map-h">Pick your town</h2>
    <p class="lead">Every pin is a home Sam has listed or sold. Tap a town and the model flies there.</p>
  </div>
  <div class="slips num" role="toolbar" aria-label="Towns" aria-orientation="horizontal" data-toolbar>
    {slips.map((c, i) => (
      <button type="button" class="slip" style={`--h:${[172, 136, 158, 128, 146, 120, 150, 132][i % 8]}px;--r:${[0, -1.2, 0, 0, 1.5, 0, -0.8, 0][i % 8]}deg`} data-town={c.slug} aria-pressed={c.slug === DEFAULT ? 'true' : 'false'} tabindex={c.slug === DEFAULT ? 0 : -1} aria-controls="map-card">
        <b>{c.name}</b>
        <span>{c.count}{c.slug === 'lehi' ? ' · home base' : ''}</span>
      </button>
    ))}
  </div>

  <div class="card dark" id="map-card" data-cards>
    <p class="sr-only" aria-live="polite" data-announce></p>
    {cards.map((c) => (
      <article class:list={['tc', { on: c.slug === DEFAULT }]} data-card={c.slug} aria-labelledby={`tc-${c.slug}`}>
        {c.lead?.photo ? (
          <Pic src={img(`listings/${c.lead.photo}`)} alt={`${c.lead.shown}, ${c.lead.townName}`} sizes="390px" ratio="r169" rv={false} widths={[390, 550]} />
        ) : (
          <div class="macro r169" aria-hidden="true">
            <svg viewBox={`${c.x - 4} ${-c.north - 2.67} 8 5.33`} preserveAspectRatio="xMidYMid slice"><use href="/map/relief-dark.svg#relief-geo" /></svg>
            {c.homes.filter((h) => h.xy).map((h) => (
              <i style={`left:${((h.xy!.x - (c.x - 4)) / 8) * 100}%;top:${((-h.xy!.north - (-c.north - 2.67)) / 5.33) * 100}%`}></i>
            ))}
          </div>
        )}
        <div class="tc-body">
          <h3 class="tc-town" id={`tc-${c.slug}`}>{c.name}</h3>
          <p class="small">{c.count || 'No homes shown here yet.'}</p>
          {c.homes.length > 0 ? (
            <ul role="list" class="tc-homes">
              {c.homes.slice(0, 3).map((h) => (
                <li data-home={h.id}>
                  <a href={h.zillow} rel="noopener" target="_blank">
                    <span class="addr">{h.shown}</span>
                    <span class="det num">{h.detail}</span>
                  </a>
                  {h.status === 'for-sale' && <button type="button" class="run small" data-run={h.price}>Run the numbers</button>}
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty">Ask Sam about {c.name}.</p>
          )}
          {c.homes.length > 3 && <p class="small tc-more">{c.homes.length - 3} more on the map and <a href={ZILLOW.profile} rel="noopener" target="_blank">on Zillow</a></p>}
          {c.rv && (
            <blockquote class="tc-q small">
              <p>“{c.rv.excerpts.town}”</p>
              <footer>{c.rv.name}, {reviewDate(c.rv.date)}, on Zillow</footer>
            </blockquote>
          )}
          <div class="tc-act">
            <button type="button" class="btn light" data-run={c.homes.find((h) => h.status === 'for-sale')?.price ?? ''}>Run the numbers</button>
            <a class="btn ghost" href={ZILLOW.profile} rel="noopener" target="_blank">See on Zillow</a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <dialog class="sheet" aria-labelledby="sheet-h" data-sheet>
    <div class="sheet-top">
      <h2 class="sheet-h" id="sheet-h">Underwrite it like Sam</h2>
      <button type="button" class="sheet-x" data-sheet-close>Close</button>
    </div>
    <p class="sheet-note small" data-sheet-note>Example numbers. Change any of them.</p>
    <Calc id="calc-map" mode="invest" compact />
  </dialog>

  <script type="application/json" data-map-json set:html={JSON.stringify(mapData)} />
</section>

<style>
  .map {
    position: relative;
    height: 100svh;
    min-height: 760px;
    overflow: hidden;
    background: #0a0a0a;
    scroll-margin-top: calc(-1 * (var(--bar) + 16px)); /* the section fills the screen: land flush (jury P1-6) */
  }
  .stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0; /* its own stack: contours, canvas, route and pins stay under the copy, card and slips */
  }
  .relief {
    width: 100%;
    height: 100%;
    transition: opacity 0.6s var(--ease-io);
  }
  .topo {
    position: absolute;
    top: 4%;
    left: 30%;
    right: 440px;
    bottom: 210px;
    z-index: 1;
    color: #fff;
    pointer-events: none;
    overflow: hidden;
    transition: opacity 0.6s var(--ease-io);
  }
  .topo path.minor {
    stroke-opacity: 0.55;
    stroke-width: 1;
  }
  .topo .home {
    fill: #fff;
    stroke: none;
  }
  /* until the contours have drawn, the model and the flat relief wait; after, the contours give way */
  .map:global(.hold) .relief,
  .map:global(.hold) :global(.relief-canvas.on),
  .map:global(.hold) .pins,
  .map:global(.hold) .overlay {
    opacity: 0;
  }
  .map:not(:global(.hold)) .topo {
    opacity: 0;
  }
  .pins,
  .overlay {
    transition: opacity 0.6s var(--ease-io);
  }
  /* V5: the line from Lehi to the picked town (map-ui.ts) */
  .stage :global(.route) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    overflow: visible;
  }
  .stage :global(.route line) {
    stroke: #fff;
    stroke-width: 1.25;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .map:not(:global(.is-gl)) .stage :global(.route) {
    display: none;
  }
  .overlay,
  .pins {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  .tl {
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 600;
    white-space: nowrap;
    padding: 2px 6px;
    background: var(--paper);
    transform: translate(10px, -50%);
    transition: background-color var(--hover), color var(--hover);
  }
  .tl.on {
    background: var(--ink);
    color: var(--paper);
  }
  .sn {
    position: absolute;
    left: 0;
    top: 0;
    width: 30px;
    transform: translate(-50%, -100%);
  }
  .sn :global(svg) {
    width: 30px;
    height: auto;
  }
  .pin {
    position: absolute;
    left: 0;
    top: 0;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    display: grid;
    place-items: center;
    pointer-events: auto;
  }
  .pin i {
    display: block;
    width: 12px;
    height: 12px;
    background: var(--ink);
    border-radius: 50%;
    outline: 2px solid var(--paper);
    transition: transform var(--hover) var(--ease-out);
  }
  .pin.for-sale i {
    border-radius: 0;
    width: 13px;
    height: 13px;
  }
  .pin:hover i,
  .pin:focus-visible i,
  .pin.on i {
    transform: scale(1.4);
  }
  .pin:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 1px;
    border-radius: 50%;
  }
  .tag {
    position: absolute;
    left: 50%;
    bottom: calc(100% - 4px);
    transform: translate(-50%, 4px);
    background: var(--ink);
    color: var(--paper);
    padding: 4px 8px;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--hover), transform var(--hover) var(--ease-out);
  }
  .pin:hover .tag,
  .pin:focus-visible .tag,
  .pin.on .tag,
  .map.is-town .pin .tag {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  /* tags never run off the stage sideways */
  .pin.flip .tag,
  .map.is-town .pin.flip .tag {
    left: auto;
    right: 50%;
    transform: translate(12px, 0);
  }
  .pin.flop .tag,
  .map.is-town .pin.flop .tag {
    left: 50%;
    transform: translate(-12px, 0);
  }
  /* live relief: labels and the SN mark are in the model; the SVG stays underneath as the poster */
  .map.is-gl .overlay {
    display: none;
  }
  .map.is-gl .pin i {
    opacity: 0;
  }
  .map.is-gl .pin:hover i,
  .map.is-gl .pin:focus-visible i,
  .map.is-gl .pin.on i {
    opacity: 0;
  }
  .map.is-gl .pin:focus-visible {
    outline-color: var(--ink);
  }

  /* a solid plate: the words never sit straight on the relief (jury P0) */
  .copy {
    position: absolute;
    top: 96px;
    left: max(var(--m), 12vw);
    width: min(520px, 60vw);
    z-index: 3;
    pointer-events: none;
    background: #0a0a0a;
    padding: 24px 28px 26px;
  }
  .copy-h {
    margin-bottom: 18px;
  }
  .slips {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 0;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 10px;
    align-items: end;
  }
  .slip {
    height: var(--h);
    background: #fff;
    color: #0a0a0a;
    text-align: left;
    padding: 18px 16px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transform: rotate(var(--r));
    transform-origin: 50% 100%;
    transition: transform 0.5s var(--ease-expo), background-color 0.3s;
  }
  .slip b {
    font-family: var(--display);
    font-weight: 600;
    font-size: 20px;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .slip span {
    font-size: 14px;
    line-height: 1.45;
  }
  .slip:hover {
    transform: translateY(-10px) rotate(var(--r));
  }
  .slip[aria-pressed='true'] {
    transform: translateY(-22px) rotate(0deg);
  }
  .slip[aria-pressed='true'] b {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }
  .slip:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  .card {
    position: absolute;
    right: var(--m);
    top: 96px;
    width: 390px;
    max-height: calc(100% - 96px - 220px);
    overflow-y: auto;
    z-index: 2;
  }
  :global(.js) .tc {
    display: none;
  }
  :global(.js) .tc.on {
    display: block;
    animation: card-in 0.15s ease-out;
  }
  @keyframes card-in {
    from {
      opacity: 0;
    }
  }
  .macro {
    position: relative;
    background: var(--paper);
    overflow: hidden;
  }
  .macro svg {
    width: 100%;
    height: 100%;
  }
  .macro i {
    position: absolute;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    background: var(--ink);
    border-radius: 50%;
    outline: 2px solid var(--paper);
  }
  .tc-body {
    padding: 20px 22px 22px;
  }
  .tc-town {
    font-size: 32px;
    letter-spacing: -0.025em;
  }
  .tc-homes {
    margin: 14px 0 0;
    display: grid;
    gap: 4px;
  }
  .tc-homes li {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 6px 12px;
    padding: 6px 8px;
    margin: 0 -8px;
    transition: background-color var(--hover);
  }
  .tc-homes li.on {
    background: #ececec;
  }
  .tc-homes a {
    text-decoration: none;
    display: grid;
  }
  .tc-homes a:hover .addr {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .addr {
    font-family: var(--display);
    font-weight: 600;
    font-size: 24px;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .det {
    font-size: 16px;
  }
  .run {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    color: var(--paper);
    min-height: 44px;
  }
  .empty {
    margin-top: 12px;
  }
  .tc-more {
    margin-top: 6px;
    font-weight: 400;
  }
  .tc-more a {
    font-weight: 600;
  }
  .card :global(.r169) {
    aspect-ratio: 21 / 9;
  }
  /* short desktop screens: the card drops its picture so its text and buttons always fit */
  @media (min-width: 1024px) and (max-height: 860px) {
    .card :global(.ph),
    .card .macro {
      display: none;
    }
  }
  .tc-q {
    margin-top: 16px;
  }
  .tc-q footer {
    margin-top: 6px;
    font-weight: 400;
  }
  .tc-act {
    display: flex;
    gap: 8px;
    margin-top: 18px;
    flex-wrap: wrap;
  }
  .tc-act .btn {
    min-height: 48px;
    padding: 0 16px;
    font-size: 16px;
  }
  .btn.ghost {
    background: #ececec;
    color: #0a0a0a;
  }
  .btn.ghost:hover {
    background: #d9d9d9;
  }

  .sheet {
    margin: auto 0 auto auto;
    height: 100dvh;
    max-height: 100dvh;
    width: min(760px, 100vw);
    max-width: 100vw;
    border: 0;
    padding: 28px var(--m) 40px;
    background: var(--paper);
    color: var(--ink);
    overflow-y: auto;
  }
  .sheet::backdrop {
    background: rgb(10 10 10 / 0.55);
  }
  .sheet[open] {
    animation: sheet-in 0.35s var(--ease-out);
  }
  @keyframes sheet-in {
    from {
      transform: translateX(40px);
      opacity: 0;
    }
  }
  .sheet-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .sheet-h {
    font-size: var(--t-sub);
  }
  .sheet-x {
    font-weight: 600;
    min-height: 48px;
    padding: 0 6px;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .sheet-note {
    margin: 8px 0 24px;
  }

  /* No JS: a plain list of towns → homes → reviews, readable top to bottom. */
  :global(html:not(.js)) .map {
    height: auto;
    min-height: 0;
    overflow: visible;
  }
  :global(html:not(.js)) .stage,
  :global(html:not(.js)) .slips {
    display: none;
  }
  :global(html:not(.js)) .copy {
    position: static;
    padding: 96px var(--m) 32px;
  }
  :global(html:not(.js)) .card {
    position: static;
    width: auto;
    max-height: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet[open],
    :global(.js) .tc.on {
      animation: none;
    }
  }

  @media (max-width: 1023px) {
    .topo {
      top: 4%;
      left: 4%;
      right: 4%;
      bottom: 4%;
    }
    .map {
      height: auto;
      min-height: 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      scroll-margin-top: 0;
    }
    .copy {
      position: static;
      order: 1;
      width: auto;
      padding: 72px var(--m) 24px;
    }
    /* the slips become one horizontal strip under the map */
    .slips {
      position: static;
      order: 3;
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      gap: 8px;
      padding: 26px var(--m) 16px;
      scrollbar-width: none;
      align-items: flex-end;
    }
    .slip {
      flex: none;
      width: 168px;
      height: auto;
      min-height: 104px;
      padding-bottom: 14px;
      scroll-snap-align: start;
      transform: none;
    }
    .slip:hover {
      transform: none;
    }
    .slip[aria-pressed='true'] {
      transform: translateY(-12px);
    }
    .stage {
      position: relative;
      order: 2;
      height: 78svh;
      min-height: 520px;
    }
    /* the card docks over the bottom of the map, so a tap on a town shows at once */
    .card {
      position: absolute;
      left: var(--m);
      right: var(--m);
      top: auto;
      bottom: calc(var(--slips-h, 150px) + var(--m));
      width: auto;
      max-height: none;
      overflow: visible;
      order: 4;
    }
    /* compact docked card: two homes, the actions; the full list and the review stay on wider screens */
    .tc-homes li:nth-child(n + 3),
    .tc-q,
    .tc-more {
      display: none;
    }
    .card :global(.ph),
    .card .macro {
      display: none;
    }
    .tc-body {
      padding: 16px 18px 18px;
    }
    .addr {
      font-size: 20px;
    }
    .tc-act {
      margin-top: 14px;
    }
    .sheet {
      margin: auto 0 0 0;
      width: 100vw;
      height: 92dvh;
    }
  }
</style>
