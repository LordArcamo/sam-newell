---
/** The contour relief geometry, defined once per page and reused with <use href="#relief-geo">. */
import geo from '../data/map-geo.json';
---
<svg class="relief-defs" aria-hidden="true" focusable="false" width="0" height="0">
  <defs>
    <g id="relief-geo">
      <!-- the model on its plinth: the paper top, an ink side below it (the brief's #131313 plinth sides) -->
      <rect x={geo.bounds.x0} y={geo.bounds.y0 + 1.2} width={geo.bounds.x1 - geo.bounds.x0} height={geo.bounds.y1 - geo.bounds.y0} class="rg-side" />
      <rect x={geo.bounds.x0} y={geo.bounds.y0} width={geo.bounds.x1 - geo.bounds.x0} height={geo.bounds.y1 - geo.bounds.y0} class="rg-top" />
      <path d={geo.lakes['great-salt-lake']} class="rg-lake" />
      <path d={geo.lakes['utah-lake']} class="rg-lake" />
      <path d={geo.minor} class="rg-minor" />
      <path d={geo.index} class="rg-index" />
    </g>
  </defs>
</svg>
<style is:global>
  .relief-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  .rg-side {
    fill: var(--ink);
  }
  .rg-top {
    fill: var(--paper);
  }
  .rg-lake {
    fill: var(--tone);
    stroke: none;
  }
  .rg-minor,
  .rg-index {
    fill: none;
    stroke: var(--ink);
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }
  .rg-minor {
    stroke-width: 1px;
    stroke-opacity: 0.32;
  }
  .rg-index {
    stroke-width: 1.6px;
    stroke-opacity: 0.6;
  }
</style>
