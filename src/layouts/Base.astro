---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, BROKERAGE, SOCIALS, ZILLOW, LICENCE } from '../data/site';
import towns from '../data/towns.json';

interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  robots?: string;
  noCanonical?: boolean;
  crumbs?: Crumb[];
  jsonld?: Record<string, unknown>[];
  published?: Date;
  modified?: Date;
}
const {
  title,
  description,
  image = '/og/home.jpg',
  imageAlt = 'Sam Newell, real estate in Lehi, Utah',
  type = 'website',
  robots = 'index, follow',
  noCanonical = false,
  crumbs,
  jsonld = [],
  published,
  modified,
} = Astro.props;

const site = SITE.url;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Person',
    '@id': `${site}/#sam`,
    name: 'Sam Newell',
    jobTitle: SITE.title,
    url: `${site}/`,
    telephone: '+1-801-995-2220',
    knowsLanguage: ['en', 'es'],
    worksFor: { '@id': `${site}/#brokerage` },
    memberOf: { '@id': `${site}/#brokerage` },
    hasCredential: {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'license',
      name: `${LICENCE.state} real estate licence ${LICENCE.number}`,
      identifier: LICENCE.number,
      recognizedBy: { '@type': 'GovernmentOrganization', name: LICENCE.issuer, url: LICENCE.issuerUrl },
    },
    sameAs: SOCIALS.map((s) => s.href),
    image: `${site}/og/home.jpg`,
  },
  {
    '@type': 'RealEstateAgent',
    '@id': `${site}/#agent`,
    name: 'Sam Newell',
    url: `${site}/`,
    logo: `${site}/brand/sam-newell-stacked-black.png`,
    image: `${site}/og/home.jpg`,
    telephone: '+1-801-995-2220',
    priceRange: '$$',
    address: { '@type': 'PostalAddress', streetAddress: BROKERAGE.street, addressLocality: BROKERAGE.city, addressRegion: BROKERAGE.region, postalCode: BROKERAGE.zip, addressCountry: 'US' },
    areaServed: towns.map((t) => ({ '@type': 'City', name: `${t.name}, Utah` })),
    employee: { '@id': `${site}/#sam` },
    parentOrganization: { '@id': `${site}/#brokerage` },
  },
  {
    '@type': 'Organization',
    '@id': `${site}/#brokerage`,
    name: BROKERAGE.name,
    telephone: '+1-801-326-8800',
    address: { '@type': 'PostalAddress', streetAddress: BROKERAGE.street, addressLocality: BROKERAGE.city, addressRegion: BROKERAGE.region, postalCode: BROKERAGE.zip, addressCountry: 'US' },
  },
  { '@type': 'WebSite', '@id': `${site}/#website`, url: `${site}/`, name: 'Sam Newell', publisher: { '@id': `${site}/#sam` }, inLanguage: 'en-US' },
];
if (crumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', path: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, site).href })),
  });
}
graph.push(...jsonld);
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
void ZILLOW;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!noCanonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/GeneralSans-Light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Switzer-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Switzer-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Switzer-Semibold.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Sam Newell" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      // Boot (≤1KB): .js flag, the real sun over Lehi now → html[data-sun] (SunCalc 1.9 subset, BSD-2).
      (function (d) {
        var h = d.documentElement, q = location.search;
        h.classList.add('js');
        // ?record without ?t freezes the same instant as the engine and the golden poster (17:45 MDT)
        var t = /[?&]record/.test(q) ? Date.parse('2026-10-21T17:45:00-06:00') : Date.now(), m = /[?&]t=([^&]+)/.exec(q);
        if (m) { var p = Date.parse(decodeURIComponent(m[1])); if (!isNaN(p)) t = p; }
        var r = Math.PI / 180, D = t / 864e5 - 0.5 + 2440588 - 2451545,
          M = r * (357.5291 + 0.98560028 * D),
          L = M + r * (1.9148 * Math.sin(M) + 0.02 * Math.sin(2 * M) + 0.0003 * Math.sin(3 * M)) + r * 102.9372 + Math.PI,
          e = r * 23.4397, dec = Math.asin(Math.sin(e) * Math.sin(L)),
          ra = Math.atan2(Math.sin(L) * Math.cos(e), Math.cos(L)),
          H = r * (280.16 + 360.9856235 * D) - r * 111.8508 - ra, f = r * 40.3916,
          alt = Math.asin(Math.sin(f) * Math.sin(dec) + Math.cos(f) * Math.cos(dec) * Math.cos(H)) / r,
          az = Math.atan2(Math.sin(H), Math.cos(H) * Math.sin(f) - Math.tan(dec) * Math.cos(f));
        h.dataset.sun = alt < -6 ? 'night' : alt < 0 ? 'blue' : alt <= 10 ? (az < 0 ? 'dawn' : 'golden') : 'noon';
        h.dataset.alt = alt.toFixed(1);
        h.dataset.t = String(t);
        if (/[?&]gl=off/.test(q)) h.dataset.gl = 'off';
        // Motion flags (Lehi Light): the opening plays once per session on the home page; a page arrived at
        // through the black curtain starts covered. Never with reduced motion, never in ?record/?capture.
        try {
          var rm = matchMedia('(prefers-reduced-motion: reduce)').matches, ss = sessionStorage, tool = /[?&](record|capture)/.test(q);
          if (!rm && !tool && location.pathname === '/' && !ss.getItem('sn-op')) { h.classList.add('op'); ss.setItem('sn-op', '1'); }
          var w = ss.getItem('sn-wipe');
          if (w) { ss.removeItem('sn-wipe'); if (!rm) { h.classList.add('arriving', 'via'); h.dataset.wipe = w; } }
        } catch (x) {}
      })(document);
    </script>
    <slot name="head" />
    <script type="application/ld+json" set:html={ld} />
  </head>
  <body>
    <div class="curtain" aria-hidden="true"><div class="curtain-c"><svg class="curtain-m" viewBox="-10 -10 325.53 358.21"><path pathLength="1" d="M0.00 243.37 L42.64 267.99 L42.64 135.72 L183.86 217.25 L183.86 267.65 L144.89 290.15 L104.47 266.82 L104.47 204.02 L63.21 180.20 L63.21 289.83 L147.01 338.21 L223.83 293.86 L223.83 237.86 L285.54 273.48 L285.54 136.96 L305.53 136.96 L305.53 91.70 L245.05 56.78 L245.05 203.23 L104.48 122.07 L104.48 71.40 L144.91 48.06 L183.86 70.55 L183.86 135.48 L223.83 158.56 L223.83 44.36 L146.99 0.00 L63.20 48.37 L63.20 99.32 L0.00 62.83 Z" /></svg><p class="curtain-t" data-curtain-t></p></div></div>
    <script is:inline>
      (function () { var t = document.documentElement.dataset.wipe; if (t) document.querySelector('[data-curtain-t]').textContent = t; })();
    </script>
    <a class="skip" href="#main">Skip to content</a>
    <Header home={Astro.url.pathname === '/'} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <div class="cur" aria-hidden="true" data-cur></div>
    <script>
      import { initMenu } from '../scripts/menu';
      import { initReveals } from '../scripts/reveal';
      import { initBar } from '../scripts/bar';
      import { initNewsletter } from '../scripts/forms';
      import { initWipe } from '../scripts/wipe';
      import { initCursor } from '../scripts/cursor';
      import { initFilms } from '../scripts/films';
      import { initLines } from '../scripts/lines';
      initWipe();
      initLines();
      initFilms();
      initCursor();
      initMenu();
      initReveals();
      initBar();
      initNewsletter();
      const idle = (fn: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 1500 }) : setTimeout(fn, 600));
      const go = () => idle(() => import('../scripts/motion').then((m) => m.initMotion()));
      if (document.readyState === 'complete') go();
      else addEventListener('load', go, { once: true });
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: fixed;
    left: var(--m);
    top: 12px;
    z-index: 200;
    background: var(--ink);
    color: var(--paper);
    padding: 14px 20px;
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-160%);
  }
  .skip:focus {
    transform: none;
  }
  main:focus {
    outline: none;
  }
</style>
