---
import Base from '../layouts/Base.astro';
import InnerHero from '../components/InnerHero.astro';
import Pic from '../components/Pic.astro';
import { img } from '../lib/images';
import { review, reviewDate } from '../data/reviews';
import { SAM_SAYS, FRAMING, FRAMING_QUOTE, ZILLOW, PODCAST, MFI, BROKERAGE, SITE, BOOKING_URL, BOOKING_EXTERNAL } from '../data/site';
import { CONFIRM } from '../data/confirm';
import { EPISODES } from '../lib/podcast';

const scott = review(8);
const firstEp = EPISODES[EPISODES.length - 1];
const year = (d: string) => new Date(d + 'T12:00:00Z').getUTCFullYear();
// Years shown only for verified items. 2010 / BYU years / CCIM stay behind CONFIRM flags.
const timeline = [
  { y: String(ZILLOW.memberSince), t: 'Joins Zillow as an agent', s: 'Member since January 2014, per his Zillow profile.' },
  ...(CONFIRM.mfiClub ? [{ y: String(MFI.founded), t: `Founds ${MFI.name}`, s: 'Larger apartment buildings, bought and run with investors.' }] : []),
  { y: String(year(firstEp.date)), t: 'Starts the podcast', s: 'First as Recession Proof, later as Get Leveraged.' },
  { y: '2025', t: 'Records episode 103', s: `The last of ${PODCAST.episodes}, on March 24, 2025. The archive stays up.` },
  { y: '2026', t: `${ZILLOW.sold} homes sold`, s: `As counted on his Zillow profile in ${ZILLOW.asOf}, with ${BROKERAGE.short}.` },
];
---
<Base
  title="About Sam Newell | Lehi Broker, Builder's Eye, Dad"
  description="Sam Newell sells homes on the Wasatch Front, frames houses with his friend Oscar at A Framing Company, and fly-fishes with his kids whenever he can."
  crumbs={[{ name: 'About', path: '/about/' }]}
>
  <InnerHero
    title={`Dad, ${SITE.title.split(' ').pop()}, fly fisherman`}
    lead="Sam sells homes on the Wasatch Front, frames houses with his friend Oscar and fly-fishes whenever he can."
    cta={{ href: BOOKING_URL, label: 'Book a call', external: BOOKING_EXTERNAL }}
    image={img('photos/family-brighton-2026-10.jpg')}
    alt="Sam with his kids, Heidi and Liam, among autumn aspens at Brighton"
    pos="50% 30%"
  />

  <section class="tl sec wrap" aria-labelledby="tl-h">
    <h2 class="h" id="tl-h" data-rv>Fifteen years in Utah real estate</h2>
    <ol role="list" class="tl-list">
      {timeline.map((t, i) => (
        <li data-rv style={`--i:${i}`}>
          <p class="tl-y num">{t.y}</p>
          <h3 class="tl-t">{t.t}</h3>
          <p class="tl-s">{t.s}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="be dark sec wrap" id="builders-eye" aria-labelledby="be-h">
    <div class="be-t">
      <h2 class="h" id="be-h" data-rv>The builder’s eye</h2>
      <p class="lead" data-rv style="--i:1">Sam studied construction management at BYU, and he still frames houses with his friend Oscar at <a class="link" href={FRAMING.url} rel="noopener" target="_blank">{FRAMING.name}</a>, from Park City to the Provo Riverbottoms. It is why he looks past the paint.</p>
      <figure class="be-q" data-rv style="--i:2">
        <blockquote class="lead"><p>“{FRAMING_QUOTE.text}”</p></blockquote>
        <figcaption>{FRAMING_QUOTE.name}, {FRAMING_QUOTE.role}</figcaption>
      </figure>
      <figure class="be-q2" data-rv style="--i:3">
        <blockquote><p>“{scott.excerpts.builder}”</p></blockquote>
        <figcaption class="small">{scott.name}, {reviewDate(scott.date)}, on Zillow</figcaption>
      </figure>
    </div>
    <div class="be-pics">
      <Pic class="be-1" src={img('photos/framing-custom-home.jpg')} alt="A three-storey custom home framed by A Framing Company" sizes="(max-width: 767px) 90vw, 36vw" ratio="r43" />
      <Pic class="be-2" src={img('photos/framing-park-city-sam.jpg')} alt="Sam on a 6,000 square foot framing job in Park City" sizes="(max-width: 767px) 44vw, 14vw" ratio="r45" pos="50% 30%" i={1} />
      <Pic class="be-3" src={img('photos/framing-provo-sam.jpg')} alt="Sam in front of a custom home being framed in the Provo Riverbottoms" sizes="(max-width: 767px) 44vw, 14vw" ratio="r45" pos="50% 30%" i={2} />
    </div>
  </section>

  <section class="fam sec wrap" id="family" aria-labelledby="fam-h">
    <h2 class="sr-only" id="fam-h">Family</h2>
    <figure class="fam-q" data-rv>
      <blockquote class="statement"><p>“{SAM_SAYS.dad.text}”</p></blockquote>
      <figcaption>Sam, on {SAM_SAYS.dad.where}, {SAM_SAYS.dad.date}</figcaption>
    </figure>
    <Pic class="fam-1" src={img('photos/family-kenai-sockeye.jpg')} alt="Sam and Liam in waders with Liam's first sockeye on the Kenai River, Alaska" sizes="(max-width: 767px) 90vw, 44vw" ratio="r1610" pos="50% 40%" />
    <Pic class="fam-2" src={img('photos/family-easter.jpg')} alt="Sam with Heidi and Liam holding stuffed animals" sizes="(max-width: 767px) 44vw, 20vw" ratio="r45" pos="50% 35%" i={1} />
    <Pic class="fam-3" src={img('photos/family-river.jpg')} alt="Sam with Heidi and Liam by a river in red-rock country" sizes="(max-width: 767px) 44vw, 24vw" ratio="r11" pos="50% 45%" i={2} />
    <p class="fam-t" data-rv style="--i:2">Most of Sam’s Instagram is Heidi and Liam: the aspens at Brighton in the fall, the Kenai River in July, and a lot of fish.</p>
  </section>
</Base>
<style>
  .tl .h {
    margin-bottom: 64px;
    max-width: 16ch;
  }
  .tl-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 40px var(--gap);
  }
  .tl-y {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(44px, 4.4vw, 72px);
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: 18px;
  }
  .tl-t {
    font-size: 24px;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .be {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 5vw;
    align-items: start;
  }
  .be-t .h {
    margin-bottom: 24px;
  }
  .be-t .link {
    font-weight: 600;
  }
  .be-q {
    margin-top: 56px;
  }
  .be-q .lead {
    font-family: var(--display);
    font-weight: 600;
    letter-spacing: -0.02em;
    max-width: 34ch;
  }
  .be-q figcaption,
  .be-q2 figcaption {
    margin-top: 14px;
  }
  .be-q2 {
    margin-top: 48px;
    max-width: 48ch;
  }
  .be-pics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
  }
  .be-pics :global(.be-1) {
    grid-column: 1 / -1;
  }
  .be-pics :global(.be-3) {
    margin-top: 80px;
  }
  .fam {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 40px var(--gap);
    align-items: start;
  }
  .fam-q {
    grid-column: 1 / 8;
  }
  .fam-q figcaption {
    margin-top: 14px;
  }
  .fam :global(.fam-1) {
    grid-column: 1 / 8;
  }
  .fam :global(.fam-2) {
    grid-column: 9 / 12;
    grid-row: 1 / 3;
    align-self: center;
  }
  .fam :global(.fam-3) {
    grid-column: 8 / 11;
  }
  .fam-t {
    grid-column: 2 / 7;
  }
  @media (max-width: 1023px) {
    .tl-list {
      grid-template-columns: 1fr 1fr;
    }
    .be {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 767px) {
    .tl-list {
      grid-template-columns: 1fr;
    }
    .fam > *,
    .fam :global(.fam-1),
    .fam :global(.fam-2),
    .fam :global(.fam-3) {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .fam :global(.fam-2),
    .fam :global(.fam-3) {
      width: 70%;
    }
  }
</style>
