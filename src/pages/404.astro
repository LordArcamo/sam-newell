---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { img } from '../lib/images';
import { BOOKING_URL, CONTACT, bookingAttrs } from '../data/site';
// The overview poster, captured from the live renderer (scripts/capture-posters.mjs).
---
<Base title="Page Not Found | Sam Newell" description="This page moved or never existed. Head home or book a call with Sam." robots="noindex, follow" noCanonical>
  <section class="nf">
    <div class="nf-t wrap">
      <h1 class="h nf-h">Not on the map</h1>
      <p class="lead">This page moved or never existed.</p>
      <p class="nf-a">
        <a class="btn" href="/">Home</a>
        <a class="btn light-o" href={BOOKING_URL} {...bookingAttrs}>Book a call</a>
        <a class="btn light-o" href={CONTACT.phoneHref}>Call {CONTACT.phone}</a>
      </p>
    </div>
    <div class="nf-p">
      <Pic src={img('posters/overview-golden.jpg')} alt="The Wasatch Front as a white relief model, seen from above Utah Lake" sizes="100vw" pos="62% 50%" eager />
    </div>
  </section>
</Base>
<style>
  .nf {
    position: relative;
    min-height: calc(100svh - var(--bar));
    display: grid;
  }
  .nf-p {
    position: absolute;
    inset: 0;
  }
  .nf-p :global(.ph) {
    height: 100%;
  }
  .nf-t {
    position: relative;
    z-index: 1;
    align-self: end;
    justify-self: start;
    background: var(--paper);
    margin: 0 0 var(--m) var(--m);
    padding: 32px;
    display: grid;
    gap: 16px;
    max-width: 560px;
  }
  .nf-a {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .light-o {
    background: var(--tone);
    color: var(--ink);
  }
  .light-o:hover {
    background: #c4c4c4;
  }
  @media (max-width: 767px) {
    .nf-t {
      margin: 0 12px 12px;
      padding: 24px;
    }
  }
</style>
