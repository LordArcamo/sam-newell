---
import Arrow from '../components/Arrow.astro';
/**
 * Home — "Lehi Light" (research-premium §4.4). Mostly black; two white chapters (the quote, the footer);
 * one big picture per screen; the live 3D relief comes back at night as the town picker.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import HeroPreload from '../components/home/HeroPreload.astro';
import MapSection from '../components/home/MapSection.astro';
import Pic from '../components/Pic.astro';
import Logo from '../components/Logo.astro';
import EpisodeRow from '../components/EpisodeRow.astro';
import OnAir from '../components/OnAir.astro';
import { img } from '../lib/images';
import { HOMES } from '../lib/homes';
import { review, reviewDate } from '../data/reviews';
import { ZILLOW, PODCAST, CONTACT, BROKERAGE, SITE, MFI, BOOKING_URL, bookingAttrs } from '../data/site';
import { CONFIRM } from '../data/confirm';
import { ep, HOME_GROUPS } from '../lib/podcast';
import { usd } from '../lib/format';
import studioPoster from '../assets/film/studio.jpg';
import keysPoster from '../assets/film/keys.jpg';

const keaton = review(1);
const byId = (id: string) => HOMES.find((h) => h.id === id)!;
const panels = [
  { h: byId('1872-s-country-ln-w-lehi'), photo: 'listings/full-1872-front-aerial.jpg', alt: '1872 S Country Ln W, Lehi, at twilight from above the street', pos: '50% 60%', wide: true },
  { h: byId('1056-w-stonehaven-dr-north-salt-lake'), photo: 'listings/full-1056-exterior.jpg', alt: '1056 W Stonehaven Dr, North Salt Lake', pos: '50% 55%' },
  { h: byId('1714-n-3870-w-lehi'), photo: 'listings/full-1714-kitchen.jpg', alt: 'The kitchen at 1714 N 3870 W, Lehi', pos: '50% 50%' },
  { h: byId('sold-w-2330-n-lehi'), photo: 'listings/full-2330-exterior.jpg', alt: 'A townhome on W 2330 N, Lehi, sold by Sam', pos: '50% 60%' },
];
// One scene: each statement cuts to its own picture of a home Sam has listed (captioned with its address).
const steps = [
  { t: 'Know what you’re buying.', href: '/buy/', photo: 'listings/scene-1872-rear-twilight.jpg', alt: 'The back of 1872 S Country Ln W, Lehi, lit at dusk', cap: '1872 S Country Ln W, Lehi', pos: '50% 55%' },
  { t: 'Priced on numbers, not hope.', href: '/sell/', photo: 'listings/scene-1056-aerial.jpg', alt: 'The neighbourhood around 1056 W Stonehaven Dr, North Salt Lake, from above', cap: 'Around 1056 W Stonehaven Dr, North Salt Lake', pos: '50% 50%' },
  { t: 'Underwrite it like Sam.', href: '/invest/', photo: 'listings/scene-1714-living.jpg', alt: 'The open living room and kitchen at 1714 N 3870 W, Lehi', cap: '1714 N 3870 W, Lehi', pos: '50% 55%' },
  ...(CONFIRM.mfiClub ? [{ t: 'Invest alongside MFI Club.', href: '/invest/#mfi-club', photo: 'listings/scene-1872-lake-aerial.jpg', alt: 'Lehi and Utah Lake from above 1872 S Country Ln W', cap: 'Lehi and Utah Lake, from above 1872 S Country Ln W', pos: '50% 50%' }] : []),
];
const figures = [
  { big: String(ZILLOW.rating), small: `out of 5 from ${ZILLOW.reviews} reviews on Zillow` },
  ...(CONFIRM.volume450M ? [{ big: '$450M+', small: 'in closed volume' }] : []),
  ...(CONFIRM.doors2000 ? [{ big: '2,000+', small: `doors through ${MFI.name}` }] : []),
];
const jsonld = [
  { '@type': 'PodcastSeries', name: PODCAST.name, url: `${SITE.url}/podcast/`, webFeed: PODCAST.rss, author: { '@id': `${SITE.url}/#sam` } },
];
---
<Base
  title="Sam Newell | Lehi Realtor, Wasatch Front"
  description="Buy, sell or invest on the Wasatch Front with Lehi Realtor Sam Newell. 235 homes sold, 4.9 from 45 Zillow reviews. Call (801) 995-2220."
  jsonld={jsonld}
>
  <HeroPreload slot="head" />
  <Hero />

  <!-- 2 · Intro: the pinned sentence, his pictures pass -->
  <section class="intro" aria-label="What Sam does" data-intro>
    <p class="statement intro-s">Honest feedback on every house, and the numbers before you offer. That’s the whole job.</p>
    <figure class="ip ip1" data-par="-14"><Pic src={img('photos/podcast-shoot-helicopter.jpg')} alt="Sam with a guest beside a helicopter on a Get Leveraged shoot" sizes="(max-width: 767px) 70vw, 26vw" ratio="r45" pos="50% 40%" rv={false} /></figure>
    <figure class="ip ip4" data-par="8"><Pic src={img('photos/framing-site-garage.jpg')} alt="A house in framing on a hillside site, with the scaffolding still up" sizes="(max-width: 767px) 90vw, 24vw" ratio="r32" rv={false} /></figure>
    <figure class="ip ip2" data-par="10" data-film="/film/studio.mp4"><Pic src={studioPoster} alt="Sam talking in the Get Leveraged studio" sizes="(max-width: 767px) 90vw, 40vw" ratio="r1610" rv={false} widths={[360, 540, 720]} /></figure>
    <figure class="ip ip3" data-par="-6" data-film="/film/keys.mp4" data-film-once><Pic src={keysPoster} alt="Keys day: confetti under the Congrats sign at Sam's office as clients close on a home" sizes="(max-width: 767px) 60vw, 24vw" ratio="r11" rv={false} widths={[360, 540, 720]} /></figure>
  </section>

  <!-- 3 · For sale now, sold lately: full panels, one midline row (a sticky stack) -->
  <section class="work" aria-labelledby="work-h">
    <header class="work-head wrap">
      <h2 class="h" id="work-h" data-rv>For sale now,<br /> sold lately</h2>
      <p class="lead" data-rv style="--i:1">Three homes on the market today and <b class="num">{ZILLOW.sold}</b> sold, as counted on Sam’s Zillow profile in {ZILLOW.asOf}.</p>
    </header>
    <ol role="list" class="panels">
      {panels.map((p, i) => (
        <li class="panel" style={`--z:${i + 1}`}>
          <a href={p.h.zillow} rel="noopener" target="_blank" data-cursor="View" aria-label={`${p.h.shown}, ${p.h.townName}: ${p.h.detail}, on Zillow`}>
            <div class:list={['panel-img', { wide: p.wide }]} data-panel-img>
              <Pic src={img(p.photo)} alt={p.alt} sizes={p.wide ? '100vw' : '(max-width: 1536px) 100vw, 1536px'} pos={p.pos} rv={false} widths={p.wide ? [768, 1152, 1536, 2048, 2560] : [768, 1152, 1536]} />
            </div>
            <div class="row">
              <span class="k">{p.h.status === 'for-sale' ? 'For sale' : 'Sold'} · {p.h.townName}</span>
              <span class="row-h">{p.h.shown}</span>
              <span class="v num">
                {p.h.status === 'for-sale' ? usd(p.h.price!) : p.h.detail}
                {p.h.facts && <small>{p.h.facts}</small>}
              </span>
            </div>
          </a>
        </li>
      ))}
    </ol>
    <p class="see-all wrap"><a class="more" href={ZILLOW.profile} rel="noopener" target="_blank">See all {ZILLOW.sold} on Zillow <Arrow /></a></p>
  </section>

  <!-- 4 · Buy, sell or invest: one scene; each statement cuts to its own home (clip from the bottom edge) -->
  <section class="scene" aria-labelledby="scene-h" data-scene style={`--n:${steps.length}`}>
    <h2 class="sr-only" id="scene-h">Buy, sell or invest</h2>
    <div class="scene-pin">
      <div class="scene-shade" aria-hidden="true"></div>
      <p class="scene-lead">Buy, sell or invest.</p>
      <ol role="list" class="stack">
        {steps.map((s, i) => (
          <li data-step={i} class:list={[{ on: i === 0 }]}>
            <figure class:list={['sb', { in: i === 0 }]} data-slide={i}>
              <Pic src={img(s.photo)} alt={s.alt} sizes="100vw" pos={s.pos} rv={false} />
              <figcaption class="sb-cap">{s.cap}</figcaption>
            </figure>
            <a class="st-a" href={s.href}>{s.t}</a>
          </li>
        ))}
      </ol>
      <p class="scene-note">Sam studied construction management at BYU. On a showing he looks past the paint to the frame, the roof and what a fix really costs. <a class="link" href="/buy/">Buying with Sam</a></p>
    </div>
  </section>

  <!-- 5 · The live relief at night: the town picker -->
  <MapSection />

  <!-- 6 · 235: the figure on the photograph's edge -->
  <section class="fig" aria-labelledby="fig-h">
    <div class="fig-photo" data-shutter><Pic src={img('listings/full-1872-drone-wasatch.jpg')} alt="Dusk over Lehi and the Wasatch from above one of Sam's listings, 1872 S Country Ln W" sizes="100vw" pos="50% 40%" rv={false} widths={[768, 1152, 1536, 2048, 2560]} /></div>
    <div class="fig-shade" aria-hidden="true"></div>
    <p class="fig-n num" aria-hidden="true" data-rise data-odo>{ZILLOW.sold}</p>
    <h2 class="sr-only" id="fig-h">{ZILLOW.sold} homes sold</h2>
    <p class="fig-exp">Homes Sam has sold, as counted on his Zillow profile in {ZILLOW.asOf}.</p>
  </section>
  <dl class="subfigs wrap num">
    {figures.map((f, i) => (
      <div data-rv style={`--i:${i}`}><dt data-odo>{f.big}</dt><dd>{f.small}</dd></div>
    ))}
  </dl>

  <!-- 7 · The quote: a white chapter -->
  <section class="quote" data-light aria-label="A client's words">
    <div class="q-photo" data-shutter><Pic src={img('photos/sam-portrait-2026-10.jpg')} alt="Sam Newell in a light-blue polo" sizes="(max-width: 767px) 90vw, 34vw" ratio="r45" pos="50% 22%" rv={false} /></div>
    <figure class="q-text" data-rv>
      <blockquote class="statement"><p>“{keaton.excerpts.home}”</p></blockquote>
      <figcaption>{keaton.name}, bought a home in 2026 · {reviewDate(keaton.date)}, on <a class="link" href={ZILLOW.profile} rel="noopener" target="_blank">Zillow</a></figcaption>
      <p class="q-all"><a class="link" href="/reviews/">Read all the reviews <Arrow /></a></p>
    </figure>
  </section>

  <!-- 8 · Lehi is home -->
  <section class="about wrap" aria-labelledby="about-h">
    <h2 class="h" id="about-h" data-rv>Lehi is home</h2>
    <p class="lead about-lead" data-rv style="--i:1">Sam sells homes up and down the Wasatch Front with {BROKERAGE.name}. He has been in Utah real estate for {SITE.yearsInRealEstate} years and answers calls and texts the same day.</p>
    <div class="tiles">
      <div class="a-photo" data-shutter>
        <a class="a-link" href="/about/" data-cursor="View" aria-label="About Sam"><Pic src={img('photos/family-brighton-2026-10-square.jpg')} alt="Sam with Heidi and Liam among autumn aspens at Brighton" sizes="(max-width: 900px) 100vw, 48vw" ratio="r11" rv={false} /></a>
      </div>
      <div class="a-tile">
        <p class="a-block">Dad of two, fly fisherman, and a builder at heart: he still frames houses with his friend Oscar at A Framing Company. <a class="link" href="/about/">More about Sam</a></p>
        <Logo variant="mark" class="a-mark" title="" />
        <dl class="facts num">
          <div><dt>Home base</dt><dd>Lehi, Utah</dd></div>
          <div><dt>Brokerage</dt><dd>{BROKERAGE.short}</dd></div>
          <div><dt>On Zillow</dt><dd>{ZILLOW.rating} from {ZILLOW.reviews} reviews</dd></div>
          <div><dt>Speaks</dt><dd>English, Spanish</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- 9 · Get Leveraged: the printed sheet on black -->
  <section class="pod wrap" aria-labelledby="pod-h">
    <div class="pod-cover" data-shutter><a class="a-link" href="/podcast/" data-cursor="Listen" aria-label="Get Leveraged, the archive"><Pic src={img('photos/get-leveraged-cover.jpg')} alt="Get Leveraged with Sam Newell, the show's cover" sizes="(max-width: 900px) 90vw, 36vw" ratio="r11" rv={false} /></a></div>
    <div class="sheet num" data-rv>
      <h2 id="pod-h">Get Leveraged</h2>
      <p class="meta">The archive: {PODCAST.episodes} episodes on investing, money and family, {PODCAST.first} to 2025. {PODCAST.rating} out of 5 on Apple from {PODCAST.ratings} ratings.</p>
      {HOME_GROUPS.map((g) => (
        <div class="grp">
          <h3>{g.name}</h3>
          <ul role="list">{g.eps.map((n) => <EpisodeRow e={ep(n)} />)}</ul>
        </div>
      ))}
      <p class="listen">
        Listen on <a class="link" href={PODCAST.spotify} rel="noopener" target="_blank">Spotify</a> ·
        <a class="link" href={PODCAST.apple} rel="noopener" target="_blank">Apple Podcasts</a> ·
        <a class="link" href="/podcast/">The full archive</a>
      </p>
    </div>
  </section>

  <!-- 10 · Talk to Sam: the visit card on a photograph -->
  <section class="talk" id="talk" aria-labelledby="talk-h">
    <div class="talk-photo" data-shutter><Pic src={img('photos/family-river.jpg')} alt="Sam with Heidi and Liam by a river in red-rock country" sizes="100vw" pos="50% 40%" rv={false} /></div>
    <div class="visit" data-rv>
      <h2 id="talk-h">Talk to Sam</h2>
      <p>Lehi, Utah. Serving Salt Lake and Utah County.</p>
      <p class="num"><a class="visit-tel" href={CONTACT.phoneHref}>Call or text {CONTACT.phone}</a></p>
      <p>English and Spanish</p>
      <a class="btn" href={BOOKING_URL} {...bookingAttrs}>Book a call <Arrow /></a>
    </div>
  </section>
  <OnAir />
</Base>

<script>
  import { initMap } from '../map/map-ui';
  import { initPlayer } from '../podcast/player';
  initMap();
  initPlayer();
</script>

<style>
  /* 2 · intro */
  .intro {
    position: relative;
    height: 108vh;
    padding-inline: var(--m);
  }
  .intro-s {
    position: sticky;
    top: 40vh;
    z-index: 2;
    margin: 0 auto;
    width: min(40vw, 600px);
    text-align: center;
    font-size: clamp(24px, 2.5vw, 36px);
    padding-top: 22vh;
  }
  .ip {
    position: absolute;
    z-index: 1;
  }
  /* the pictures keep to the side columns: nothing ever crosses the sentence; every screen of the run holds two */
  .ip1 {
    left: 3vw;
    top: 2vh;
    width: 26vw;
  }
  .ip2 {
    right: 2vw;
    top: 16vh;
    width: 28vw;
  }
  .ip3 {
    left: 8vw;
    top: 62vh;
    width: 19vw;
  }
  .ip4 {
    right: 3vw;
    top: 54vh;
    width: 25vw;
  }

  /* 3 · listing panels: each panel sticks, the next slides over it */
  .work-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 32px;
    padding-top: 140px;
    padding-bottom: 64px;
  }
  .work-head .lead {
    justify-self: end;
    max-width: 40ch;
  }
  .panels {
    position: relative;
  }
  /* each listing is a full-height window; its picture travels more slowly than the page (motion.ts) */
  .panel {
    position: relative;
    height: min(72vh, 56.25vw);
    overflow: hidden;
    background: #0a0a0a;
  }
  .panel + .panel {
    margin-top: 10px;
  }
  .panel > a {
    display: block;
    height: 100%;
    color: #fff;
    text-decoration: none;
  }
  /* 1536 px originals: never stretched past their width; wider screens get the black field around them */
  /* a 16:9 window, centred, never taller than 72vh; the picture travels a little inside it (motion.ts) */
  .panel-img {
    position: absolute;
    inset: -6% 0;
    width: min(100%, calc(72vh * 16 / 9), 1536px);
    margin-inline: auto;
  }
  /* 4K upscales (2560 px) can go wider than 1536 */
  .panel-img.wide,
  .panel-img.wide + .row {
    width: min(100%, calc(72vh * 16 / 9));
  }
  .panel-img :global(.ph) {
    height: 100%;
    background: #141414;
  }
  /* the row sits on the picture's own width, never out in the black margins */
  .row {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(100%, calc(72vh * 16 / 9), 1536px);
    transform: translate(-50%, -50%);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) auto;
    align-items: baseline;
    gap: 24px;
    padding: 28px 32px;
    background: rgb(10 10 10 / 0.72);
    transition: background-color 0.4s;
  }
  .panel a:hover .row,
  .panel a:focus-visible .row {
    background: rgb(10 10 10 / 0.86);
  }
  .panel a:focus-visible {
    outline: 3px solid #fff;
    outline-offset: -8px;
  }
  .k {
    font-size: 16px;
    font-weight: 500;
  }
  .row-h {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(30px, 3vw, 48px);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .v {
    text-align: right;
    font-size: 19px;
    font-weight: 500;
  }
  .v small {
    display: block;
    margin-top: 8px;
    font-size: 15px;
    font-weight: 400;
  }
  .see-all {
    position: relative;
    z-index: 9;
    background: #0a0a0a;
    padding-top: 48px;
    padding-bottom: 140px;
    font-size: 19px;
  }

  /* 4 · one scene (pinned by CSS sticky; motion.ts hands the light from line to line and cuts the pictures) */
  .scene {
    position: relative;
    height: calc(var(--n) * 60vh + 100vh);
  }
  .scene-pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 12vh;
  }
  /* every picture fills the pinned screen; the active one and those before it are open, the rest wait below */
  .sb {
    position: absolute;
    inset: 0;
    z-index: 0;
    clip-path: inset(100% 0 0 0);
    transition: clip-path 1.1s var(--ease-expo);
  }
  .sb:global(.in) {
    clip-path: inset(0 0 0 0);
  }
  .sb :global(.ph) {
    height: 100%;
  }
  .sb :global(img) {
    transform: scale(1.06);
    transition: transform 1.8s var(--ease-out);
  }
  .sb:global(.in) :global(img) {
    transform: none;
  }
  .sb-cap {
    position: absolute;
    right: var(--m);
    bottom: 40px;
    z-index: 2;
    font-size: 15px;
    font-weight: 500;
    color: #fff;
  }
  .scene-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgb(10 10 10 / 0.35);
    pointer-events: none;
  }
  .scene-shade::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 34%;
    background: linear-gradient(to top, rgb(10 10 10 / 0.7), rgb(10 10 10 / 0)); /* taste-skill-ignore gradient: neutral scrim under the note on a photo */
  }
  .scene-lead {
    position: relative;
    z-index: 2;
    font-weight: 500;
    font-size: 18px;
    margin-bottom: 18px;
  }
  .stack {
    display: grid;
    gap: 2px;
    text-align: center;
  }
  .st-a {
    position: relative;
    z-index: 2;
    display: inline-block;
    font-family: var(--display);
    font-weight: 400;
    font-size: 48px;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-decoration: none;
    opacity: 0.35;
    transform: scale(0.62);
    transition: transform 0.7s var(--ease-expo), opacity 0.7s var(--ease-expo);
  }
  .stack li:global(.on) .st-a {
    opacity: 1;
    transform: none;
  }
  .st-a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
  .scene-note {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    width: min(560px, 60vw);
    text-align: center;
    z-index: 2;
    font-size: 18px;
  }
  /* no motion, or a phone: the four statements stack, each under its own picture */
  @media (max-width: 900px), (prefers-reduced-motion: reduce) {
    .scene {
      height: auto;
    }
    .scene-pin {
      position: relative;
      height: auto;
      display: block;
      padding: 96px var(--m);
      overflow: visible;
    }
    .scene-shade {
      display: none;
    }
    .stack {
      gap: 56px;
      text-align: left;
    }
    .sb {
      position: relative;
      inset: auto;
      clip-path: none;
      aspect-ratio: 4 / 3;
      margin-bottom: 18px;
    }
    .sb :global(img) {
      transform: none;
    }
    .sb-cap {
      left: 12px;
      right: auto;
      top: 12px;
      bottom: auto;
      font-size: 14px;
      padding: 4px 8px;
      background: rgb(10 10 10 / 0.72);
    }
    .st-a {
      opacity: 1;
      transform: none;
      font-size: 32px;
    }
    .scene-note {
      position: static;
      transform: none;
      width: auto;
      text-align: left;
      margin-top: 56px;
    }
  }
  @media (max-width: 900px) {
    .sb {
      aspect-ratio: 4 / 5;
    }
  }

  /* 6 · 235 */
  .fig {
    position: relative;
    height: 88svh;
    min-height: 560px;
    overflow: hidden;
  }
  .fig-photo {
    position: absolute;
    inset: 0;
  }
  .fig-photo :global(.ph) {
    height: 100%;
  }
  .fig-shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 44%;
    background: rgb(10 10 10 / 0.6);
  }
  .fig-n {
    position: absolute;
    left: var(--m);
    bottom: 0.04em;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(140px, 19vw, 300px);
    line-height: 0.8;
    letter-spacing: -0.06em;
  }
  .fig-exp {
    position: absolute;
    right: var(--m);
    bottom: 36px;
    width: 26ch;
    text-align: right;
    font-size: 19px;
  }
  @media (max-width: 900px) {
    /* phones: photo, shade and number share one 4:5 cell; the line sits under the photo, never over the number */
    .fig {
      height: auto;
      min-height: 0;
      display: grid;
      grid-template-areas: 'p' 'e';
    }
    .fig-photo,
    .fig-shade,
    .fig-n {
      grid-area: p;
      position: relative;
      inset: auto;
    }
    .fig-photo {
      aspect-ratio: 4 / 5;
    }
    .fig-shade {
      align-self: end;
    }
    .fig-n {
      align-self: end;
      justify-self: start;
      left: auto;
      bottom: auto;
      margin: 0 0 -0.04em var(--m);
    }
    .fig-exp {
      grid-area: e;
      position: static;
      width: auto;
      text-align: left;
      padding: 20px var(--m) 0;
    }
  }
