---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import MapSection from '../components/home/MapSection.astro';
import Pic from '../components/Pic.astro';
import Logo from '../components/Logo.astro';
import EpisodeRow from '../components/EpisodeRow.astro';
import OnAir from '../components/OnAir.astro';
import { img } from '../lib/images';
import { FOR_SALE, SOLD, TOWNS } from '../lib/homes';
import { review, reviewDate } from '../data/reviews';
import { ZILLOW, PODCAST, CONTACT, BROKERAGE, SITE, MFI } from '../data/site';
import { CONFIRM } from '../data/confirm';
import { ep, HOME_GROUPS } from '../lib/podcast';

const keaton = review(1);
const rows = [...FOR_SALE, ...SOLD.slice(0, 4)];
const lehi = TOWNS.find((t) => t.slug === 'lehi')!;
const figures = [
  { big: String(ZILLOW.rating), small: `out of 5 from ${ZILLOW.reviews} reviews on Zillow` },
  { big: `${SITE.yearsInRealEstate} years`, small: 'in Utah real estate' },
  ...(CONFIRM.volume450M ? [{ big: '$450M+', small: 'in closed volume' }] : []),
  ...(CONFIRM.doors2000 ? [{ big: '2,000+', small: `doors through ${MFI.name}` }] : []),
];
const jsonld = [
  {
    '@type': 'PodcastSeries',
    name: PODCAST.name,
    url: `${SITE.url}/podcast/`,
    webFeed: PODCAST.rss,
    author: { '@id': `${SITE.url}/#sam` },
  },
];
---
<Base
  title="Sam Newell | Lehi Real Estate Broker, Wasatch Front"
  description="Buy, sell or invest on the Wasatch Front with Lehi broker Sam Newell. 235 homes sold, 4.9 from 45 Zillow reviews. Call (801) 995-2220."
  jsonld={jsonld}
>
  <Hero />

  <!-- 2 · Intro: the statement, photos pass in the side columns -->
  <section class="intro sec wrap" aria-label="Sam's promise">
    <Pic class="i1" src={img('photos/framed-house-wasatch.jpg')} alt="A new house framed in timber below the Wasatch mountains" sizes="(max-width: 767px) 60vw, 22vw" ratio="r45" pos="58% 50%" />
    <p class="statement intro-s" data-rv><span>Honest feedback on every house.</span><br /> <span>The numbers before you offer.</span></p>
    <div class="i-right">
      <Pic class="i2" src={img('photos/listing-kitchen-2026-05.jpg')} alt="A bright listing kitchen with a quartz island, Lehi" sizes="(max-width: 767px) 80vw, 26vw" ratio="r1610" pos="50% 62%" i={1} />
      <Pic class="i3" src={img('photos/family-river.jpg')} alt="Sam with Heidi and Liam by a river in red-rock country" sizes="(max-width: 767px) 50vw, 18vw" ratio="r11" pos="50% 45%" i={2} />
    </div>
  </section>

  <!-- 3 · Homes: big names, fixed preview -->
  <section class="homes dark sec wrap" aria-labelledby="homes-h" data-homes>
    <div class="homes-list">
      <h2 class="h" id="homes-h" data-rv>For sale now,<br /> sold lately</h2>
      <ol role="list" class="rows">
        {rows.map((h, i) => (
          <li class:list={['row', { on: i === 0 }]} data-row={h.id} data-rv style={`--i:${i % 4}`}>
            <a href={h.zillow} rel="noopener" target="_blank">
              <span class="r-name">{h.shown}, {h.townName}</span>
              <span class="r-det num">{h.detail}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="homes-foot small" data-rv>
        {ZILLOW.sold} homes sold, as counted on Sam’s Zillow profile in {ZILLOW.asOf}.
        <a class="link" href="#map">See them on the map</a>
        <a class="link" href={ZILLOW.profile} rel="noopener" target="_blank">All of Sam’s sales on Zillow</a>
      </p>
    </div>
    <div class="preview" aria-hidden="true">
      {rows.map((h, i) => (
        <figure class:list={['pv', { on: i === 0 }]} data-pv={h.id}>
          {h.photo ? (
            <Pic src={img(`listings/${h.photo}`)} alt="" sizes="26vw" ratio="r45" rv={false} widths={[360, 550]} />
          ) : (
            <div class="pv-map r45">
              <svg viewBox={`${h.xy ? h.xy.x - 3 : lehi.x - 3} ${h.xy ? -h.xy.north - 3.75 : -lehi.north - 3.75} 6 7.5`} preserveAspectRatio="xMidYMid slice"><use href="/map/relief.svg#relief-geo" /></svg>
              {h.xy && <i></i>}
            </div>
          )}
          <figcaption class="small">{h.facts || (h.xy ? `${h.shown}, ${h.townName}, on the contour map` : `${h.shown}, ${h.townName}`)}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- 4 · Buy, sell or invest: rows with margin photos -->
  <section class="bsi sec wrap" aria-labelledby="bsi-h">
    <h2 class="h" id="bsi-h" data-rv>Buy, sell or invest.</h2>
    <div class="bsi-row">
      <Pic src={img('photos/framing-custom-home.jpg')} alt="A three-storey custom home framed by A Framing Company" sizes="(max-width: 767px) 90vw, 22vw" ratio="r43" />
      <div class="bsi-t" data-rv style="--i:1">
        <h3>Know what you’re buying</h3>
        <p>Sam studied construction management at BYU and still works on framing jobs. On a showing he looks past the paint to the roof, the frame and what a fix really costs.</p>
        <a class="more" href="/buy/">Buying with Sam <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="bsi-row flip">
      <div class="bsi-t" data-rv>
        <h3>Priced on numbers, not hope</h3>
        <p>Pricing is a science; the story is an art. Sam prices from recent sales near you and tells you straight what to fix and what to leave.</p>
        <a class="more" href="/sell/">Selling with Sam <span aria-hidden="true">→</span></a>
      </div>
      <Pic src={img('listings/1056-w-stonehaven-dr-nsl.jpg')} alt="1056 W Stonehaven Dr, North Salt Lake, listed by Sam" sizes="(max-width: 767px) 90vw, 22vw" ratio="r43" i={1} widths={[360, 550]} />
    </div>
    <div class="bsi-row">
      <Pic src={img('photos/estate-lots-jordan-river.jpg')} alt="Estate lots above the Jordan River, Lehi, with the Wasatch behind" sizes="(max-width: 767px) 60vw, 16vw" ratio="r11" pos="50% 40%" />
      <div class="bsi-t" data-rv style="--i:1">
        <h3>Underwrite it like Sam</h3>
        <p>Rentals are Sam’s specialty, from a first rental to a new townhome for an out-of-state investor. Run the numbers his way before you make an offer.</p>
        <a class="more" href="/invest/">Run the numbers <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 5 · One review -->
  <section class="review wrap" aria-label="A client's words">
    <Pic src={img('photos/sam-portrait-2026-10.jpg')} alt="Sam Newell in a light-blue polo in a staged living room" sizes="(max-width: 767px) 90vw, 36vw" ratio="r45" pos="50% 30%" />
    <figure class="rv-q" data-rv style="--i:1">
      <blockquote class="statement"><p>“{keaton.excerpts.home}”</p></blockquote>
      <figcaption>{keaton.name}, {reviewDate(keaton.date)}, on <a class="link" href={ZILLOW.profile} rel="noopener" target="_blank">Zillow</a></figcaption>
    </figure>
  </section>

  <!-- 6 · The map (the live thing) -->
  <MapSection />

  <!-- 7 · 235: the figure on the photo's edge -->
  <section class="proof dark" aria-labelledby="proof-h">
    <div class="proof-photo">
      <Pic src={img('photos/valley-view-utah-county.jpg')} alt="Utah County from a new home: a road, a golden field and the valley running to the mountains" sizes="(max-width: 767px) 100vw, 1350px" pos="50% 37%" rv={false} />
    </div>
    <div class="proof-fig wrap">
      <p class="title proof-n num" aria-hidden="true" data-rise>{ZILLOW.sold}</p>
      <div class="proof-t">
        <h2 class="lead" id="proof-h"><span class="sr-only">{ZILLOW.sold} </span>Homes sold</h2>
        <p>Homes Sam has sold, as counted on his Zillow profile in {ZILLOW.asOf}.</p>
      </div>
    </div>
    <dl class="figs wrap sec-b">
      {figures.map((f, i) => (
        <div data-rv style={`--i:${i}`}>
          <dt class="fig-b num">{f.big}</dt>
          <dd>{f.small}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- 8 · About: wide photo, colour tile, facts -->
  <section class="about sec wrap" aria-labelledby="about-h">
    <div class="about-main">
      <h2 class="h" id="about-h" data-rv>Lehi is home</h2>
      <p class="lead about-lead" data-rv style="--i:1">Sam sells homes up and down the Wasatch Front with {BROKERAGE.name}. He has been in Utah real estate for {SITE.yearsInRealEstate} years, and he answers calls and texts the same day.</p>
      <div class="about-photo">
        <Pic src={img('photos/family-kenai-sockeye.jpg')} alt="Sam and his son Liam in waders, holding Liam's first sockeye on the Kenai River, Alaska" sizes="(max-width: 767px) 100vw, 56vw" ratio="r1610" pos="50% 40%" />
        <p class="about-block" data-rv style="--i:2">Sam studied construction management at BYU and still frames houses with his friend Oscar at A Framing Company. It is why he looks past the paint. <a class="more" href="/about/">More about Sam <span aria-hidden="true">→</span></a></p>
      </div>
    </div>
    <div class="tile">
      <div class="tile-map" aria-hidden="true">
        <svg viewBox="-21 -56.4 46.3 97.6" preserveAspectRatio="xMidYMid meet"><use href="/map/relief.svg#relief-geo" /></svg>
        <span class="tile-sn" style={`left:${((lehi.x + 21) / 46.3) * 100}%;top:${((-lehi.north + 56.4) / 97.6) * 100}%`}><Logo variant="mark" title="" /> Lehi</span>
      </div>
      <dl class="facts">
        <div><dt>Home base</dt><dd>Lehi</dd></div>
        <div><dt>Brokerage</dt><dd>{BROKERAGE.short}</dd></div>
        <div><dt>On Zillow</dt><dd>{ZILLOW.rating} from {ZILLOW.reviews} reviews</dd></div>
        <div><dt>Speaks</dt><dd>English and Spanish</dd></div>
      </dl>
    </div>
  </section>

  <!-- 9 · Get Leveraged: the printed sheet -->
  <section class="pod dark sec wrap" aria-labelledby="pod-h">
    <Pic class="pod-photo" src={img('photos/podcast-studio.jpg')} alt="Sam on a leather sofa in the Get Leveraged interview room" sizes="(max-width: 767px) 90vw, 24vw" ratio="r11" pos="50% 40%" />
    <div class="sheet-p" data-rv style="--i:1">
      <h2 class="h" id="pod-h">Get Leveraged</h2>
      <p class="meta">The archive: {PODCAST.episodes} episodes on investing, money and family, {PODCAST.first} to 2025. {PODCAST.rating} out of 5 on Apple from {PODCAST.ratings} ratings.</p>
      {HOME_GROUPS.map((g) => (
        <div class="grp">
          <h3>{g.name}</h3>
          <ul role="list">{g.eps.map((n) => <EpisodeRow e={ep(n)} />)}</ul>
        </div>
      ))}
      <p class="listen">
        Listen on <a class="link" href={PODCAST.spotify} rel="noopener" target="_blank">Spotify</a> ·
        <a class="link" href={PODCAST.apple} rel="noopener" target="_blank">Apple Podcasts</a> ·
        <a class="link" href="/podcast/">The full archive</a>
      </p>
    </div>
  </section>

  <!-- 10 · Talk to Sam: the visit card on a photo -->
  <section class="talk" id="talk" aria-labelledby="talk-h">
    <Pic class="talk-photo" src={img('photos/family-brighton-2026-10.jpg')} alt="Sam with his kids, Heidi and Liam, among autumn aspens at Brighton" sizes="(max-width: 767px) 100vw, 100vw" pos="50% 34%" rv={false} />
    <div class="visit">
      <h2 class="h" id="talk-h">Talk to Sam</h2>
      <p>Lehi, Utah. Serving Salt Lake and Utah County.</p>
      <p class="visit-call"><a href={CONTACT.phoneHref}>Call or text {CONTACT.phone}</a></p>
      <p>English and Spanish</p>
      <a class="btn" href={CONTACT.calendly} rel="noopener" target="_blank">Book a call <span class="arrow" aria-hidden="true">→</span></a>
      <a class="more visit-more" href="/contact/">Or send a message <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <OnAir />
</Base>

<script>
  import { initMap } from '../map/map-ui';
  import { initPlayer } from '../podcast/player';
  import { mountRelief } from '../relief/mount';
  // Homes index: the fixed preview follows hover and focus.
  const homes = document.querySelector('[data-homes]');
  if (homes) {
    const set = (id: string) => {
      homes.querySelectorAll<HTMLElement>('[data-row]').forEach((r) => r.classList.toggle('on', r.dataset.row === id));
      homes.querySelectorAll<HTMLElement>('[data-pv]').forEach((p) => p.classList.toggle('on', p.dataset.pv === id));
    };
    homes.querySelectorAll<HTMLElement>('[data-row]').forEach((r) => {
      r.addEventListener('mouseenter', () => set(r.dataset.row!));
      r.addEventListener('focusin', () => set(r.dataset.row!));
    });
  }
  initMap();
  initPlayer();
  // Hero GL takeover (resolves null until the model ships; the poster stays as the hero).
  const heroMount = document.querySelector<HTMLElement>('[data-relief-mount="hero"]');
  if (heroMount) {
    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      mountRelief(heroMount, { role: 'hero' });
    };
    const now = /[?&](record|capture)/.test(location.search);
    if (now) start();
    else if (matchMedia('(min-width: 768px)').matches) {
      // desktop: the poster is the LCP and is identical to the first GL frame, so the engine (and its one-off
      // texture upload) waits for the visitor's first move, or for 6 s of quiet after load
      ['pointermove', 'scroll', 'keydown', 'touchstart'].forEach((ev) => addEventListener(ev, start, { once: true, passive: true }));
      addEventListener('load', () => setTimeout(() => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 2000 }) : start()), 6000), { once: true });
    }
    else ['touchstart', 'scroll', 'keydown'].forEach((ev) => addEventListener(ev, start, { once: true, passive: true }));
  }
</script>

<style>
  /* 2 · intro */
  .intro {
    display: grid;
    grid-template-columns: 18vw 1fr 22vw;
    gap: 3vw;
    align-items: start;
  }
  .intro-s {
    align-self: center;
    text-align: center;
    font-size: 36px;
    margin-inline: auto;
  }
  @media (min-width: 1200px) {
    .intro-s span {
      white-space: nowrap;
    }
  }
  @media (max-width: 1199px) {
    .intro-s {
      font-size: 24px;
    }
  }
  .i-right :global(.i2) {
    margin-top: 160px;
  }
  .i-right :global(.i3) {
    width: 15vw;
    margin-top: 56px;
  }

  /* 3 · homes */
  .homes {
    display: grid;
    grid-template-columns: 1fr 26vw;
    gap: 5vw;
  }
  .homes .h {
    margin-bottom: 48px;
  }
  .row a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: baseline;
    padding: 12px 0;
    text-decoration: none;
    transition: padding-left var(--hover) var(--ease-out);
  }
  .r-name {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(24px, 2.5vw, 36px);
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .row.on a {
    padding-left: 12px;
  }
  .row.on .r-name {
    font-weight: 600;
  }
  .row a:focus-visible {
    outline-offset: 2px;
  }
  .r-det {
    font-size: 18px;
    white-space: nowrap;
  }
  .homes-foot {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-weight: 400;
  }
  .preview {
    position: sticky;
    top: calc(var(--bar) + 40px);
    align-self: start;
    margin-top: 120px;
    display: grid;
  }
  .pv {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden; /* not painted while idle (each holds a <use> of the whole relief) */
    transition: opacity 0.2s, visibility 0s 0.2s;
  }
  .pv.on {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.2s;
  }
  .pv figcaption {
    margin-top: 10px;
  }
  .pv-map {
    position: relative;
    background: var(--paper);
    overflow: hidden;
  }
  .pv-map svg {
    width: 100%;
    height: 100%;
  }
  .pv-map i {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 16px;
    margin: -8px 0 0 -8px;
    background: var(--ink);
    border-radius: 50%;
    outline: 3px solid var(--paper);
  }

  /* 4 · buy, sell or invest */
  .bsi .h {
    margin-bottom: 40px;
  }
  .bsi-row {
    display: grid;
    grid-template-columns: 22vw minmax(0, 1fr) 22vw;
    gap: 4vw;
    align-items: center;
    padding: 36px 0;
  }
  .bsi-row > :global(.ph) {
    grid-column: 1;
  }
  .bsi-row .bsi-t {
    grid-column: 2;
    max-width: 60ch;
  }
  .bsi-row.flip > :global(.ph) {
    grid-column: 3;
    grid-row: 1;
  }
  .bsi-row.flip .bsi-t {
    grid-row: 1;
  }
  .bsi-row:last-child > :global(.ph) {
    width: 16vw;
    justify-self: end;
  }
  .bsi-t h3 {
    font-size: var(--t-sub);
    letter-spacing: -0.025em;
    margin-bottom: 12px;
  }
  .bsi-t p {
    margin-bottom: 16px;
  }

  /* 5 · review */
  .review {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 5vw;
    align-items: end;
    padding-bottom: var(--sec);
  }
  .rv-q .statement {
    font-size: clamp(24px, 2.5vw, 36px);
  }
  .rv-q figcaption {
    margin-top: 24px;
  }

  /* 7 · proof */
  .proof-photo {
    max-width: 1350px;
    margin-inline: auto;
    height: 82svh;
    min-height: 520px;
  }
  .proof-photo :global(.ph) {
    height: 100%;
  }
  .proof-fig {
    display: grid;
    grid-template-columns: auto minmax(0, 380px);
    justify-content: space-between;
    align-items: end;
    gap: 32px;
    margin-top: -0.1em;
  }
  .proof-n {
    font-size: clamp(140px, 22vw, 340px);
    line-height: 0.78;
    margin-top: 36px;
  }
  .proof-t h2 {
    font-family: var(--display);
    font-weight: 600;
    margin-bottom: 6px;
  }
  .figs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    padding-top: 96px;
    padding-bottom: var(--sec);
  }
  .fig-b {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(44px, 5vw, 76px);
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin-bottom: 10px;
  }

  /* 8 · about */
  .about {
    content-visibility: auto;
    contain-intrinsic-size: auto 1000px;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: 4vw;
  }
  .about .h {
    margin-bottom: 22px;
  }
  .about-lead {
    max-width: 40ch;
    margin-bottom: 44px;
  }
  .about-photo {
    position: relative;
  }
  .about-block {
    position: absolute;
    top: 24px;
    right: 24px;
    width: min(330px, 46%);
    background: var(--paper);
    padding: 20px 22px;
    font-size: 18px;
  }
  .about-block .more {
    display: inline-flex;
    margin-top: 8px;
  }
  .tile {
    background: var(--tone);
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
  }
  .tile-map {
    position: relative;
    aspect-ratio: 46.3 / 97.6;
    max-height: 560px;
    margin-inline: auto;
    width: 100%;
    max-width: calc(560px * 46.3 / 97.6);
  }
  .tile-map svg {
    width: 100%;
    height: 100%;
  }
  .tile-sn {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 6px;
    transform: translate(-11px, -50%);
    font-weight: 600;
    font-size: 16px;
    background: var(--tone);
    padding-right: 6px;
  }
  .tile-sn :global(svg) {
    width: 22px;
    height: auto;
  }
  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 28px;
  }
  .facts dt {
    font-size: 16px;
    font-weight: 500;
  }
  .facts dd {
    font-weight: 600;
  }

  /* 9 · podcast */
  .pod {
    display: grid;
    grid-template-columns: 24vw minmax(0, 680px);
    gap: 4vw;
    justify-content: center;
    align-items: start;
  }
  .sheet-p {
    background: var(--paper);
    color: var(--ink);
    padding: 44px 48px 40px;
  }
  .sheet-p .h {
    font-size: var(--t-head);
    margin-bottom: 12px;
  }
  .meta {
    margin-bottom: 18px;
  }
  .grp h3 {
    font-size: 24px;
    letter-spacing: -0.02em;
    margin: 22px 0 6px;
  }
  .listen {
    margin-top: 28px;
  }

  /* 10 · talk */
  .talk {
    position: relative;
    height: 100svh;
    min-height: 720px;
    overflow: hidden;
    background: var(--ink);
  }
  .talk :global(.talk-photo) {
    position: absolute;
    inset: 0;
  }
  .visit {
    position: absolute;
    top: 60px;
    right: var(--m);
    width: 400px;
    background: var(--paper);
    padding: 32px;
    z-index: 1;
  }
  .visit .h {
    font-size: var(--t-head);
    margin-bottom: 14px;
  }
  .visit p {
    margin-bottom: 6px;
  }
  .visit-call a {
    font-weight: 600;
    text-decoration: none;
    font-size: 24px;
  }
  .visit .btn {
    width: 100%;
    margin-top: 20px;
  }
  .visit-more {
    margin-top: 16px;
  }

  @media (max-width: 1023px) {
    .review {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .review :global(.ph) {
      max-width: 420px;
    }
    .rv-q .statement {
      font-size: 24px;
