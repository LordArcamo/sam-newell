---
/**
 * Home — "Lehi Light" (research-premium §4.4). Mostly black; two white chapters (the quote, the footer);
 * one big picture per screen; the live 3D relief comes back at night as the town picker.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import HeroPreload from '../components/home/HeroPreload.astro';
import MapSection from '../components/home/MapSection.astro';
import Pic from '../components/Pic.astro';
import Logo from '../components/Logo.astro';
import EpisodeRow from '../components/EpisodeRow.astro';
import OnAir from '../components/OnAir.astro';
import { img } from '../lib/images';
import { HOMES } from '../lib/homes';
import { review, reviewDate } from '../data/reviews';
import { ZILLOW, PODCAST, CONTACT, BROKERAGE, SITE, MFI, BOOKING_URL, bookingAttrs } from '../data/site';
import { CONFIRM } from '../data/confirm';
import { ep, HOME_GROUPS } from '../lib/podcast';
import { usd } from '../lib/format';
import studioPoster from '../assets/film/studio.jpg';
import keysPoster from '../assets/film/keys.jpg';

const keaton = review(1);
const byId = (id: string) => HOMES.find((h) => h.id === id)!;
const panels = [
  { h: byId('1872-s-country-ln-w-lehi'), photo: 'listings/full-1872-twilight-front.jpg', alt: '1872 S Country Ln W, Lehi, at twilight', pos: '50% 62%' },
  { h: byId('1056-w-stonehaven-dr-north-salt-lake'), photo: 'listings/full-1056-exterior.jpg', alt: '1056 W Stonehaven Dr, North Salt Lake', pos: '50% 55%' },
  { h: byId('1714-n-3870-w-lehi'), photo: 'listings/full-1714-kitchen.jpg', alt: 'The kitchen at 1714 N 3870 W, Lehi', pos: '50% 50%' },
  { h: byId('sold-w-2330-n-lehi'), photo: 'listings/full-2330-exterior.jpg', alt: 'A townhome on W 2330 N, Lehi, sold by Sam', pos: '50% 60%' },
];
const steps = [
  { t: 'Know what you’re buying.', href: '/buy/' },
  { t: 'Priced on numbers, not hope.', href: '/sell/' },
  { t: 'Underwrite it like Sam.', href: '/invest/' },
  ...(CONFIRM.mfiClub ? [{ t: 'Invest alongside MFI Club.', href: '/invest/#mfi-club' }] : []),
];
const figures = [
  { big: String(ZILLOW.rating), small: `out of 5 from ${ZILLOW.reviews} reviews on Zillow` },
  ...(CONFIRM.volume450M ? [{ big: '$450M+', small: 'in closed volume' }] : []),
  ...(CONFIRM.doors2000 ? [{ big: '2,000+', small: `doors through ${MFI.name}` }] : []),
];
const jsonld = [
  { '@type': 'PodcastSeries', name: PODCAST.name, url: `${SITE.url}/podcast/`, webFeed: PODCAST.rss, author: { '@id': `${SITE.url}/#sam` } },
];
---
<Base
  title="Sam Newell | Lehi Real Estate Broker, Wasatch Front"
  description="Buy, sell or invest on the Wasatch Front with Lehi broker Sam Newell. 235 homes sold, 4.9 from 45 Zillow reviews. Call (801) 995-2220."
  jsonld={jsonld}
>
  <HeroPreload slot="head" />
  <Hero />

  <!-- 2 · Intro: the pinned sentence, his pictures pass -->
  <section class="intro" aria-label="What Sam does" data-intro>
    <p class="statement intro-s">Honest feedback on every house, and the numbers before you offer. That’s the whole job.</p>
    <figure class="ip ip1" data-par="-14"><Pic src={img('photos/sam-portrait-2026-10.jpg')} alt="Sam Newell" sizes="(max-width: 767px) 70vw, 26vw" ratio="r45" pos="50% 25%" rv={false} /></figure>
    <figure class="ip ip2" data-par="10" data-cursor="Play" data-film="/film/studio.mp4"><Pic src={studioPoster} alt="Sam talking in the Get Leveraged studio" sizes="(max-width: 767px) 90vw, 40vw" ratio="r1610" rv={false} widths={[360, 540, 720]} /></figure>
    <figure class="ip ip3" data-par="-6" data-cursor="Play" data-film="/film/keys.mp4"><Pic src={keysPoster} alt="Keys day: confetti under the Congrats sign at Sam's office as clients close on a home" sizes="(max-width: 767px) 60vw, 24vw" ratio="r11" rv={false} widths={[360, 540, 720]} /></figure>
  </section>

  <!-- 3 · For sale now, sold lately: full panels, one midline row (a sticky stack) -->
  <section class="work" aria-labelledby="work-h">
    <header class="work-head wrap">
      <h2 class="h" id="work-h" data-rv>For sale now,<br /> sold lately</h2>
      <p class="lead" data-rv style="--i:1">Three homes on the market today and <b class="num">{ZILLOW.sold}</b> sold, as counted on Sam’s Zillow profile in {ZILLOW.asOf}.</p>
    </header>
    <ol role="list" class="panels">
      {panels.map((p, i) => (
        <li class="panel" style={`--z:${i + 1}`}>
          <a href={p.h.zillow} rel="noopener" target="_blank" data-cursor="View" aria-label={`${p.h.shown}, ${p.h.townName}: ${p.h.detail}, on Zillow`}>
            <div class="panel-img" data-panel-img>
              <Pic src={img(p.photo)} alt={p.alt} sizes="(max-width: 1536px) 100vw, 1536px" pos={p.pos} rv={false} widths={[768, 1152, 1536]} />
            </div>
            <div class="row">
              <span class="k">{p.h.status === 'for-sale' ? 'For sale' : 'Sold'} · {p.h.townName}</span>
              <span class="row-h">{p.h.shown}</span>
              <span class="v num">
                {p.h.status === 'for-sale' ? usd(p.h.price!) : p.h.detail}
                {p.h.facts && <small>{p.h.facts}</small>}
              </span>
            </div>
          </a>
        </li>
      ))}
    </ol>
    <p class="see-all wrap"><a class="more" href={ZILLOW.profile} rel="noopener" target="_blank">See all {ZILLOW.sold} on Zillow <span aria-hidden="true">→</span></a></p>
  </section>

  <!-- 4 · Buy, sell or invest: one scene, stepping statements -->
  <section class="scene" aria-labelledby="scene-h" data-scene style={`--n:${steps.length}`}>
    <div class="scene-pin">
      <div class="scene-bg" data-cursor="Film"><Pic src={img('photos/framed-house-wasatch.jpg')} alt="A new house in timber framing below the Wasatch" sizes="100vw" pos="55% 45%" rv={false} /></div>
      <div class="scene-shade" aria-hidden="true"></div>
      <h2 class="sr-only" id="scene-h">Buy, sell or invest</h2>
      <p class="scene-lead">Buy, sell or invest.</p>
      <ol role="list" class="stack">
        {steps.map((s, i) => (
          <li data-step={i} class:list={[{ on: i === 0 }]}><a href={s.href}>{s.t}</a></li>
        ))}
      </ol>
      <figure class="pair pa"><Pic src={img('photos/framing-provo-sam.jpg')} alt="Sam on a framing job in the Provo Riverbottoms" sizes="22vw" ratio="r45" pos="50% 30%" rv={false} /></figure>
      <figure class="pair pb"><Pic src={img('photos/framing-custom-home.jpg')} alt="A three-storey custom home framed by A Framing Company" sizes="22vw" ratio="r32" rv={false} /></figure>
      <p class="scene-note">Sam studied construction management at BYU. On a showing he looks past the paint to the frame, the roof and what a fix really costs. <a class="link" href="/buy/">Buying with Sam</a></p>
    </div>
  </section>

  <!-- 5 · The live relief at night: the town picker -->
  <MapSection />

  <!-- 6 · 235: the figure on the photograph's edge -->
  <section class="fig" aria-labelledby="fig-h">
    <div class="fig-photo" data-shutter><Pic src={img('listings/full-1872-drone-wasatch.jpg')} alt="Dusk over Lehi and the Wasatch from above one of Sam's listings, 1872 S Country Ln W" sizes="(max-width: 1536px) 100vw, 1536px" pos="50% 40%" rv={false} widths={[768, 1152, 1536]} /></div>
    <div class="fig-shade" aria-hidden="true"></div>
    <p class="fig-n num" aria-hidden="true" data-rise>{ZILLOW.sold}</p>
    <h2 class="sr-only" id="fig-h">{ZILLOW.sold} homes sold</h2>
    <p class="fig-exp">Homes Sam has sold, as counted on his Zillow profile in {ZILLOW.asOf}.</p>
  </section>
  <dl class="subfigs wrap num">
    {figures.map((f, i) => (
      <div data-rv style={`--i:${i}`}><dt>{f.big}</dt><dd>{f.small}</dd></div>
    ))}
  </dl>

  <!-- 7 · The quote: a white chapter -->
  <section class="quote" data-light aria-label="A client's words">
    <div class="q-photo" data-shutter><Pic src={img('photos/sam-portrait-2026-10.jpg')} alt="Sam Newell in a light-blue polo" sizes="(max-width: 767px) 90vw, 34vw" ratio="r45" pos="50% 22%" rv={false} /></div>
    <figure class="q-text" data-rv>
      <blockquote class="statement"><p>“{keaton.excerpts.home}”</p></blockquote>
      <figcaption>{keaton.name}, bought a home in 2026 · {reviewDate(keaton.date)}, on <a class="link" href={ZILLOW.profile} rel="noopener" target="_blank">Zillow</a></figcaption>
    </figure>
  </section>

  <!-- 8 · Lehi is home -->
  <section class="about wrap" aria-labelledby="about-h">
    <h2 class="h" id="about-h" data-rv>Lehi is home</h2>
    <p class="lead about-lead" data-rv style="--i:1">Sam sells homes up and down the Wasatch Front with {BROKERAGE.name}. He has been in Utah real estate for {SITE.yearsInRealEstate} years and answers calls and texts the same day.</p>
    <div class="tiles">
      <div class="a-photo" data-shutter data-cursor="View">
        <Pic src={img('photos/family-brighton-2026-10.jpg')} alt="Sam with Heidi and Liam among autumn aspens at Brighton" sizes="(max-width: 900px) 100vw, 64vw" pos="50% 32%" rv={false} />
        <p class="a-block">Dad of two, fly fisherman, and a builder at heart: he still frames houses with his friend Oscar at A Framing Company. <a class="link" href="/about/">More about Sam</a></p>
      </div>
      <div class="a-tile">
        <Logo variant="mark" class="a-mark" title="" />
        <dl class="facts num">
          <div><dt>Home base</dt><dd>Lehi, Utah</dd></div>
          <div><dt>Brokerage</dt><dd>{BROKERAGE.short}</dd></div>
          <div><dt>On Zillow</dt><dd>{ZILLOW.rating} from {ZILLOW.reviews} reviews</dd></div>
          <div><dt>Speaks</dt><dd>English, Spanish</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- 9 · Get Leveraged: the printed sheet on black -->
  <section class="pod wrap" aria-labelledby="pod-h">
    <div class="pod-cover" data-shutter data-cursor="Play"><Pic src={img('photos/get-leveraged-cover.jpg')} alt="Get Leveraged with Sam Newell, the show's cover" sizes="(max-width: 900px) 90vw, 36vw" ratio="r11" rv={false} /></div>
    <div class="sheet num" data-rv>
      <h2 id="pod-h">Get Leveraged</h2>
      <p class="meta">The archive: {PODCAST.episodes} episodes on investing, money and family, {PODCAST.first} to 2025. {PODCAST.rating} out of 5 on Apple from {PODCAST.ratings} ratings.</p>
      {HOME_GROUPS.map((g) => (
        <div class="grp">
          <h3>{g.name}</h3>
          <ul role="list">{g.eps.map((n) => <EpisodeRow e={ep(n)} />)}</ul>
        </div>
      ))}
      <p class="listen">
        Listen on <a class="link" href={PODCAST.spotify} rel="noopener" target="_blank">Spotify</a> ·
        <a class="link" href={PODCAST.apple} rel="noopener" target="_blank">Apple Podcasts</a> ·
        <a class="link" href="/podcast/">The full archive</a>
      </p>
    </div>
  </section>

  <!-- 10 · Talk to Sam: the visit card on a photograph -->
  <section class="talk" id="talk" aria-labelledby="talk-h">
    <div class="talk-photo" data-shutter><Pic src={img('photos/family-river.jpg')} alt="Sam with Heidi and Liam by a river in red-rock country" sizes="100vw" pos="50% 40%" rv={false} /></div>
    <div class="visit" data-rv>
      <h2 id="talk-h">Talk to Sam</h2>
      <p>Lehi, Utah. Serving Salt Lake and Utah County.</p>
      <p class="num"><a class="visit-tel" href={CONTACT.phoneHref}>Call or text {CONTACT.phone}</a></p>
      <p>English and Spanish</p>
      <a class="btn" href={BOOKING_URL} {...bookingAttrs}>Book a call <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
  <OnAir />
</Base>

<script>
  import { initMap } from '../map/map-ui';
  import { initPlayer } from '../podcast/player';
  initMap();
  initPlayer();
</script>

<style>
  /* 2 · intro */
  .intro {
    position: relative;
    height: 170vh;
    padding-inline: var(--m);
  }
  .intro-s {
    position: sticky;
    top: 40vh;
    z-index: 2;
    margin: 0 auto;
    width: min(40vw, 600px);
    text-align: center;
    font-size: 36px;
    padding-top: 30vh;
  }
  .ip {
    position: absolute;
    z-index: 1;
  }
  /* the pictures keep to the side columns: nothing ever crosses the sentence */
  .ip1 {
    left: 3vw;
    top: 4vh;
    width: 25vw;
  }
  .ip2 {
    right: 0;
    top: 58vh;
    width: 29vw;
  }
  .ip3 {
    left: 6vw;
    top: 108vh;
    width: 22vw;
  }

  /* 3 · listing panels: each panel sticks, the next slides over it */
  .work-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 32px;
    padding-top: 140px;
    padding-bottom: 64px;
  }
  .work-head .lead {
    justify-self: end;
    max-width: 40ch;
  }
  .panels {
    position: relative;
  }
  .panel {
    position: sticky;
    top: 0;
    height: 100svh;
    z-index: var(--z);
    overflow: hidden;
    background: #0a0a0a;
  }
  .panel > a {
    display: block;
    height: 100%;
    color: #fff;
    text-decoration: none;
  }
  /* 1536 px originals: never stretched past their width; wider screens get the black field around them */
  .panel-img {
    position: absolute;
    inset: 0;
    max-width: 1536px;
    margin-inline: auto;
  }
  .panel-img :global(.ph) {
    height: 100%;
    background: #141414;
  }
  .row {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    grid-template-columns: 22vw 1fr auto;
    align-items: baseline;
    gap: 24px;
    padding: 28px var(--m);
    background: rgb(10 10 10 / 0.72);
    transition: background-color 0.4s;
  }
  .panel a:hover .row,
  .panel a:focus-visible .row {
    background: rgb(10 10 10 / 0.86);
  }
  .panel a:focus-visible {
    outline: 3px solid #fff;
    outline-offset: -8px;
  }
  .k {
    font-size: 16px;
    font-weight: 500;
  }
  .row-h {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(30px, 3vw, 48px);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .v {
    text-align: right;
    font-size: 19px;
    font-weight: 500;
  }
  .v small {
    display: block;
    margin-top: 8px;
    font-size: 15px;
    font-weight: 400;
  }
  .see-all {
    position: relative;
    z-index: 9;
    background: #0a0a0a;
    padding-top: 48px;
    padding-bottom: 140px;
    font-size: 19px;
  }

  /* 4 · one scene, stepping statements (pinned by CSS sticky; motion.ts steps the statements) */
  .scene {
    position: relative;
    height: calc(var(--n) * 80vh + 100vh);
  }
  .scene-pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .scene-bg {
    position: absolute;
    inset: 0;
  }
  .scene-bg :global(.ph) {
    height: 100%;
  }
  .scene-shade {
    position: absolute;
    inset: 0;
    background: rgb(10 10 10 / 0.5);
  }
  .scene-lead {
    position: absolute;
    top: 11vh;
    left: 0;
    right: 0;
    text-align: center;
    font-weight: 500;
    font-size: 18px;
    z-index: 2;
  }
  .stack {
    position: absolute;
    top: 17vh;
    left: 0;
    right: 0;
    z-index: 2;
    text-align: center;
    display: grid;
    gap: 6px;
  }
  .stack li {
    font-family: var(--display);
    font-weight: 400;
    font-size: 48px;
    letter-spacing: -0.03em;
    line-height: 1.15;
    transform: scale(0.5);
    transition: transform 0.6s var(--ease-expo);
  }
  .stack li.on {
    transform: none;
  }
  .stack a {
    text-decoration: none;
  }
  .stack a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
  .pair {
    position: absolute;
    z-index: 1;
    width: 22vw;
  }
  .pa {
    left: 5vw;
    top: 44vh;
  }
  .pb {
    right: 5vw;
    top: 54vh;
  }
  .scene-note {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    width: min(580px, 90vw);
    text-align: center;
    z-index: 2;
    font-size: 19px;
  }

  /* 6 · 235 */
  .fig {
    position: relative;
    height: 88svh;
    min-height: 560px;
    overflow: hidden;
  }
  .fig-photo {
    position: absolute;
    inset: 0;
    max-width: 1536px;
    margin-inline: auto;
  }
  .fig-photo :global(.ph) {
    height: 100%;
  }
  .fig-shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 44%;
    background: rgb(10 10 10 / 0.6);
  }
  .fig-n {
    position: absolute;
    left: var(--m);
    bottom: 0.04em;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(140px, 19vw, 300px);
    line-height: 0.8;
    letter-spacing: -0.06em;
  }
  .fig-exp {
    position: absolute;
    right: var(--m);
    bottom: 36px;
    width: 26ch;
    text-align: right;
    font-size: 19px;
  }
  .subfigs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    padding-top: 64px;
    padding-bottom: 160px;
  }
  .subfigs dt {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(48px, 5vw, 80px);
    letter-spacing: -0.04em;
    line-height: 1;
    margin-bottom: 10px;
  }

  /* 7 · the quote: white chapter */
  .quote {
    background: #fff;
    color: #0a0a0a;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    padding: 180px var(--m);
  }
  .q-photo {
    grid-column: 2 / 6;
  }
  .q-text {
    grid-column: 7 / 12;
    align-self: center;
  }
  .q-text .statement {
    font-size: clamp(26px, 2.5vw, 36px);
  }
  .q-text figcaption {
    margin-top: 32px;
    font-size: 16px;
    font-weight: 500;
  }

  /* 8 · about */
  .about {
    padding-top: 180px;
    padding-bottom: 160px;
  }
  .about .h {
    margin-bottom: 24px;
  }
  .about-lead {
    max-width: 46ch;
    margin-bottom: 72px;
  }
  .tiles {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 16px;
  }
  .a-photo {
    position: relative;
    aspect-ratio: 16 / 10;
  }
  .a-photo :global(.ph) {
    height: 100%;
  }
  .a-block {
    position: absolute;
    top: 0;
    right: 0;
    width: min(340px, 50%);
    background: #fff;
    color: #0a0a0a;
    padding: 22px 24px;
    font-size: 17px;
  }
  .a-tile {
    background: #1c1c1c;
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
  }
  .a-tile :global(.a-mark) {
    width: 72px;
    height: auto;
  }
  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 24px;
  }
  .facts dt {
    font-size: 15px;
  }
  .facts dd {
    font-weight: 600;
  }

  /* 9 · podcast */
  .pod {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 640px);
    gap: 6vw;
    padding-top: 160px;
    padding-bottom: 160px;
    align-items: start;
  }
  .sheet {
    background: #fff;
    color: #0a0a0a;
    padding: 56px 60px;
  }
  .sheet h2 {
    font-size: 52px;
    margin-bottom: 12px;
  }
  .meta {
    font-size: 16px;
    margin-bottom: 20px;
  }
  .grp h3 {
    font-size: 21px;
    letter-spacing: -0.015em;
    margin: 26px 0 8px;
  }
  .sheet :global(.ep-play) {
    background: #0a0a0a;
  }
  .sheet :global(.ep-play i) {
    border-left-color: #fff;
  }
  .sheet :global(.ep-btn:hover) {
    background: #ececec;
  }
  .listen {
    margin-top: 28px;
  }

  /* 10 · talk */
  .talk {
    position: relative;
    height: 100svh;
    min-height: 680px;
    overflow: hidden;
  }
  .talk-photo {
    position: absolute;
    inset: 0;
  }
  .talk-photo :global(.ph) {
    height: 100%;
  }
  .visit {
    position: absolute;
    top: 60px;
    right: 60px;
    width: 400px;
    background: #fff;
    color: #0a0a0a;
    padding: 34px;
  }
  .visit h2 {
    font-size: 40px;
    margin-bottom: 14px;
  }
  .visit p {
    margin-bottom: 6px;
    font-size: 17px;
  }
  .visit-tel {
    font-weight: 600;
    text-decoration: none;
  }
  .visit .btn {
    width: 100%;
    margin-top: 22px;
    background: #0a0a0a;
    color: #fff;
  }
  .visit .btn:hover {
    background: #303030;
  }

  @media (prefers-reduced-motion: reduce) {
    .stack li {
      transform: none;
      font-size: 36px;
    }
    .scene {
      height: auto;
    }
    .scene-pin {
      position: relative;
      height: auto;
      min-height: 100svh;
      padding-bottom: 160px;
    }
  }

  @media (max-width: 900px) {
    .intro {
      height: auto;
      padding-top: 96px;
      padding-bottom: 96px;
      display: grid;
