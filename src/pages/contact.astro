---
import Base from '../layouts/Base.astro';
import InnerHero from '../components/InnerHero.astro';
import Pic from '../components/Pic.astro';
import { img } from '../lib/images';
import { CONTACT, BROKERAGE, LICENCE, BOOKING_URL, BOOKING_EXTERNAL } from '../data/site';
---
<Base
  title="Contact Sam Newell | Call or Text (801) 995-2220"
  description="Talk to Lehi Realtor Sam Newell: call or text (801) 995-2220, book a time online, or send a message. English and Spanish."
  crumbs={[{ name: 'Contact', path: '/contact/' }]}
>
  <InnerHero
    title="Talk to Sam"
    lead={`Call or text ${CONTACT.phone}, or book a time that suits you.`}
    cta={BOOKING_EXTERNAL ? { href: BOOKING_URL, label: 'Book a call', external: true } : { href: '#message', label: 'Send a message' }}
    image={img('photos/family-festival-colors.jpg')}
    alt="Sam and Heidi covered in colour at a Festival of Colors"
    pos="50% 30%"
  />

  <section class="ct sec wrap" aria-labelledby="ct-h">
    <div class="ct-side">
      <h2 class="h" id="ct-h" data-rv>Send a message</h2>
      <p class="lead" data-rv style="--i:1">Sam answers the same day. For anything urgent, call or text.</p>
      <dl class="ct-facts" data-rv style="--i:2">
        <div><dt>Call or text</dt><dd><a href={CONTACT.phoneHref}>{CONTACT.phone}</a></dd></div>
        <div><dt>Brokerage</dt><dd>{BROKERAGE.name}<br />{BROKERAGE.street}<br />{BROKERAGE.city}, {BROKERAGE.region} {BROKERAGE.zip}</dd></div>
        <div><dt>Licence</dt><dd>{LICENCE.state} licence #{LICENCE.number}</dd></div>
        <div><dt>Speaks</dt><dd>English and Spanish</dd></div>
      </dl>
    </div>
    <form class="form" id="message" action="/api/contact/" method="post" data-contact>
      <label class="f"><span class="fl">Name</span><input name="name" autocomplete="name" required /></label>
      <label class="f"><span class="fl">Email</span><input name="email" type="email" autocomplete="email" required /></label>
      <label class="f"><span class="fl">Phone (optional)</span><input name="phone" type="tel" autocomplete="tel" /></label>
      <label class="f"><span class="fl">I want to</span>
        <select name="subject">
          <option>Buy a home</option>
          <option>Sell a home</option>
          <option>Buy a rental</option>
          <option>Something else</option>
        </select>
      </label>
      <label class="f wide"><span class="fl">Message</span><textarea name="message" rows="6" required></textarea></label>
      <div class="hp" aria-hidden="true"><label for="ct-co">Company</label><input id="ct-co" name="company" tabindex="-1" autocomplete="off" /></div>
      <div class="wide send">
        <button class="btn" type="submit">Send to Sam</button>
        <p class="msg" tabindex="-1" data-contact-msg></p>
      </div>
    </form>
  </section>

  <section class="where dark sec wrap" aria-labelledby="where-h">
    <h2 class="h" id="where-h" data-rv>Where Sam works</h2>
    <div class="where-grid">
      <figure>
        <div data-shutter><Pic src={img('photos/estate-lots-jordan-river.jpg')} alt="Estate lots above the Jordan River, Lehi" sizes="(max-width: 900px) 100vw, 28vw" ratio="r43" pos="50% 40%" /></div>
        <figcaption class="small">Lehi, home base</figcaption>
      </figure>
      <figure>
        <div data-shutter><Pic src={img('listings/1056-w-stonehaven-dr-nsl.jpg')} alt="1056 W Stonehaven Dr, North Salt Lake" sizes="(max-width: 900px) 100vw, 28vw" ratio="r43" i={1} widths={[360, 550]} /></div>
        <figcaption class="small">North Salt Lake, listed now</figcaption>
      </figure>
      <figure>
        <div data-shutter><Pic src={img('photos/valley-view-utah-county.jpg')} alt="A Utah County valley from a new home" sizes="(max-width: 900px) 100vw, 28vw" ratio="r43" pos="50% 40%" i={2} /></div>
        <figcaption class="small">Utah County</figcaption>
      </figure>
    </div>
  </section>
</Base>
<script>
  import { initContact } from '../scripts/forms';
  initContact();
</script>
<style>
  .ct {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 5vw;
    align-items: start;
  }
  .ct-side .h {
    margin-bottom: 16px;
  }
  .ct-side .lead {
    margin-bottom: 40px;
  }
  .ct-facts {
    display: grid;
    gap: 20px;
  }
  .ct-facts dt {
    font-size: 16px;
    font-weight: 500;
  }
  .ct-facts dd {
    font-weight: 600;
  }
  .ct-facts a {
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }
  .form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .f {
    display: grid;
    gap: 6px;
  }
  .f.wide,
  .wide {
    grid-column: 1 / -1;
  }
  .fl {
    font-size: 16px;
    font-weight: 600;
  }
  .f input,
  .f select,
  .f textarea {
    width: 100%;
    min-height: 52px;
    padding: 12px 14px;
    background: var(--tone);
    border: 0;
    border-radius: 0;
    font-size: 18px;
    appearance: none;
  }
  .f textarea {
    resize: vertical;
  }
  .f input:focus-visible,
  .f select:focus-visible,
  .f textarea:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  .send {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }
  .msg {
    font-weight: 600;
  }
  .msg:focus {
    outline: none;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .where .h {
    margin-bottom: 48px;
  }
  .where-grid {
    display: grid;
    grid-template-columns: repeat(3, 28vw);
    justify-content: space-between;
    align-items: start;
  }
  .where-grid figcaption {
    margin-top: 10px;
  }
  @media (max-width: 900px) {
    .ct {
      grid-template-columns: 1fr;
    }
    .where-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

  }
  @media (max-width: 520px) {
    .form {
      grid-template-columns: 1fr;
    }
  }
</style>
