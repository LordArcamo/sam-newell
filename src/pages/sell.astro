---
import Base from '../layouts/Base.astro';
import InnerHero from '../components/InnerHero.astro';
import Steps from '../components/Steps.astro';
import Quotes from '../components/Quotes.astro';
import Pic from '../components/Pic.astro';
import { img } from '../lib/images';
import { review } from '../data/reviews';
import { CONTACT, ZILLOW } from '../data/site';
import { SOLD, FOR_SALE } from '../lib/homes';

// [SAM TO CONFIRM the four process lines]
const steps = [
  { h: 'Price from real sales', p: 'Sam prices your home from recent sales near you, not from hope, and shows you the sales he used.', img: img('listings/1872-s-country-ln-w-lehi.jpg'), alt: '1872 S Country Ln W, Lehi, listed by Sam' },
  { h: 'Fix what pays', p: 'He tells you straight what to fix and what to leave. Years on framing jobs mean he knows what a repair really costs.', img: img('photos/framed-house-wasatch.jpg'), alt: 'A new house framed in timber below the Wasatch', pos: '60% 50%' },
  { h: 'Show it well', p: 'Clean photos, a listing written to be read, and walk-through videos Sam shares on his own Instagram and TikTok.', img: img('listings/1714-n-3870-w-lehi.jpg'), alt: '1714 N 3870 W, Lehi, listed by Sam' },
  { h: 'Negotiate the net', p: 'What matters is what you keep. Sam negotiates price, repairs and terms with your net in mind, and keeps you posted until closing.' },
];
const recent = SOLD.slice(0, 4);
---
<Base
  title="Sell Your Home on the Wasatch Front | Sam Newell"
  description="Sell with Lehi broker Sam Newell: priced from real sales near you, straight advice on what to fix, and 235 homes sold as counted on Zillow."
  crumbs={[{ name: 'Sell', path: '/sell/' }]}
>
  <InnerHero
    title="Priced on numbers"
    lead="Pricing is a science; the story is an art."
    cta={{ href: CONTACT.calendly, label: 'Book a call', external: true }}
    image={img('photos/listing-kitchen-2026-05.jpg')}
    alt="A bright kitchen with a quartz island and pendant lights in a home Sam listed in Lehi"
    pos="50% 62%"
  />
  <Steps heading="How selling with Sam works" steps={steps} id="sell" />

  <section class="sold dark sec wrap" aria-labelledby="sold-h">
    <div class="sold-fig">
      <p class="title sold-n num" aria-hidden="true" data-rise>{ZILLOW.sold}</p>
      <h2 class="lead" id="sold-h"><span class="sr-only">{ZILLOW.sold} </span>homes sold, as counted on Sam’s Zillow profile in {ZILLOW.asOf}</h2>
    </div>
    <div class="sold-list">
      <h3 class="sold-h3">Sold lately</h3>
      <ul role="list">
        {recent.map((h, i) => (
          <li data-rv style={`--i:${i}`}><span class="s-name">{h.shown}, {h.townName}</span><span class="small num">{h.detail}</span></li>
        ))}
      </ul>
      <h3 class="sold-h3">Listed now</h3>
      <ul role="list">
        {FOR_SALE.map((h, i) => (
          <li data-rv style={`--i:${i}`}><a href={h.zillow} rel="noopener" target="_blank"><span class="s-name">{h.address}, {h.townName}</span><span class="small num">{h.detail}</span></a></li>
        ))}
      </ul>
      <p class="small sold-note">Street names only for sold homes, to protect Sam’s clients. <a class="link" href={ZILLOW.profile} rel="noopener" target="_blank">Every sale on Zillow</a></p>
    </div>
    <Pic class="sold-pic" src={img('listings/1056-w-stonehaven-dr-nsl.jpg')} alt="1056 W Stonehaven Dr, North Salt Lake, listed by Sam" sizes="(max-width: 767px) 90vw, 26vw" ratio="r45" widths={[360, 550]} />
  </section>

  <Quotes heading="In sellers’ words" a={{ r: review(12), key: 'sell' }} b={{ r: review(17), key: 'sell' }} />
</Base>
<style>
  .sold {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) 22vw;
    gap: 4vw;
    align-items: start;
  }
  .sold-n {
    font-size: clamp(140px, 17vw, 280px);
    line-height: 0.8;
    margin-bottom: 24px;
  }
  .sold-fig .lead {
    max-width: 22ch;
    font-family: var(--display);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .sold-h3 {
    font-size: 24px;
    margin: 0 0 14px;
  }
  .sold-list ul {
    display: grid;
    gap: 14px;
    margin-bottom: 40px;
  }
  .sold-list li,
  .sold-list li a {
    display: grid;
    gap: 2px;
    text-decoration: none;
  }
  .sold-list a:hover .s-name {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .s-name {
    font-family: var(--display);
    font-weight: 600;
    font-size: 24px;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .sold-note {
    font-weight: 400;
  }
  @media (max-width: 1023px) {
    .sold {
      grid-template-columns: 1fr 1fr;
    }
    .sold-fig {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 767px) {
    .sold {
      grid-template-columns: 1fr;
    }
    .sold :global(.sold-pic) {
      width: 70%;
    }
  }
</style>
