---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';
import TalkStrip from '../../components/TalkStrip.astro';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, others: posts.filter((p) => p.id !== post.id) } }));
}
const { post, others } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const fmt = (x: Date) => x.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const path = `/blog/${post.id}/`;
const modified = d.updated ?? d.date;
const jsonld = [
  {
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    datePublished: d.date.toISOString(),
    dateModified: modified.toISOString(),
    image: d.cover ? new URL(d.cover.src, SITE.url).href : `${SITE.url}/og/home.jpg`,
    author: { '@id': `${SITE.url}/#sam` },
    publisher: { '@id': `${SITE.url}/#sam` },
    mainEntityOfPage: new URL(path, SITE.url).href,
  },
];
---
<Base
  title={`${d.title.length > 48 ? d.title.slice(0, d.title.lastIndexOf(' ', 48)) + '…' : d.title} | Sam Newell`}
  description={d.description.length > 160 ? d.description.slice(0, 157) + '…' : d.description}
  type="article"
  image={d.cover?.src}
  imageAlt={d.coverAlt}
  crumbs={[{ name: 'Blog', path: '/blog/' }, { name: d.title, path }]}
  jsonld={jsonld}
  published={d.date}
  modified={modified}
>
  <article class="art">
    <header class="art-h wrap">
      <p class="small"><a href="/blog/">Notes from Sam</a> · {d.tag} · <time datetime={d.date.toISOString()}>{fmt(d.date)}</time></p>
      <h1 class="h art-title">{d.title}</h1>
      <p class="lead">{d.description}</p>
    </header>
    {d.cover && (
      <div class="art-cover">
        <Pic src={d.cover} alt={d.coverAlt ?? ''} sizes="(max-width: 767px) 100vw, 1100px" ratio="r1610" eager />
      </div>
    )}
    <div class="prose wrap">
      <Content />
    </div>
  </article>
  {others.length > 0 && (
    <section class="more-notes sec wrap" aria-labelledby="mn-h">
      <h2 class="h" id="mn-h" data-rv>More notes</h2>
      <ul role="list" class="mn">
        {others.map((p, i) => (
          <li>
            {p.data.cover && <Pic src={p.data.cover} alt={p.data.coverAlt ?? ''} sizes="(max-width: 767px) 90vw, 30vw" ratio="r32" i={i} />}
            <h3><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
          </li>
        ))}
      </ul>
    </section>
  )}
  <TalkStrip />
</Base>
<style>
  .art-h {
    padding-top: 96px;
    padding-bottom: 48px;
    max-width: 1100px;
    margin-inline: auto;
  }
  .art-h .small a {
    font-weight: 600;
  }
  .art-title {
    font-size: clamp(36px, 3.8vw, 60px);
    margin: 16px 0 20px;
  }
  .art-cover {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: var(--m);
  }
  .prose {
    max-width: calc(68ch + 2 * var(--m));
    margin: 64px auto 0;
    font-size: 19px;
    line-height: 1.65;
  }
  .prose :global(h2) {
    font-size: 30px;
    letter-spacing: -0.025em;
    margin: 56px 0 14px;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 20px;
  }
  .prose :global(li) {
    margin: 0 0 8px 1.2em;
  }
  .prose :global(a) {
    font-weight: 600;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .mn {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 40px var(--gap);
    margin-top: 40px;
  }
  .mn h3 {
    font-size: 24px;
    letter-spacing: -0.02em;
    margin-top: 14px;
  }
  .mn a {
    text-decoration: none;
  }
  .mn a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
</style>
