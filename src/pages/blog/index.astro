---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import InnerHero from '../../components/InnerHero.astro';
import Pic from '../../components/Pic.astro';
import TalkStrip from '../../components/TalkStrip.astro';
import { img } from '../../lib/images';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts[0];
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base
  title="Notes from Sam | Utah Real Estate Blog"
  description="Short reads from Lehi broker Sam Newell on buying, selling and investing in Utah County and Salt Lake."
  crumbs={[{ name: 'Blog', path: '/blog/' }]}
>
  <InnerHero
    title="Notes from Sam"
    lead="Short reads on buying, selling and investing in Utah."
    cta={latest ? { href: `/blog/${latest.id}/`, label: 'Read the latest' } : undefined}
    image={latest?.data.cover ?? img('photos/valley-view-utah-county.jpg')}
    alt={latest?.data.coverAlt ?? ''}
  />
  <section class="posts sec wrap" aria-labelledby="posts-h">
    <h2 class="sr-only" id="posts-h">All notes</h2>
    <ol role="list" class="post-list">
      {posts.map((p, i) => (
        <li class="post">
          {p.data.cover && <Pic src={p.data.cover} alt={p.data.coverAlt ?? ''} sizes="(max-width: 767px) 90vw, 30vw" ratio="r32" i={i} />}
          <div class="post-t" data-rv style={`--i:${i + 1}`}>
            <p class="small">{p.data.tag} · <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time></p>
            <h3><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
            <p>{p.data.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
  <TalkStrip />
</Base>
<style>
  .post-list {
    display: grid;
    gap: 72px;
  }
  .post {
    display: grid;
    grid-template-columns: 30vw minmax(0, 1fr);
    gap: 4vw;
    align-items: center;
  }
  .post:nth-child(even) {
    grid-template-columns: minmax(0, 1fr) 30vw;
  }
  .post:nth-child(even) :global(.ph) {
    order: 2;
  }
  .post h3 {
    font-size: clamp(28px, 2.6vw, 40px);
    letter-spacing: -0.025em;
    margin: 8px 0 12px;
    max-width: 24ch;
  }
  .post h3 a {
    text-decoration: none;
  }
  .post h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }
  .post-t > p:last-child {
    max-width: 60ch;
  }
  @media (max-width: 767px) {
    .post,
    .post:nth-child(even) {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .post:nth-child(even) :global(.ph) {
      order: 0;
    }
  }
</style>
